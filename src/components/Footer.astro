---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { t, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const EMAIL = 'ryanchyy@gmail.com';
// The resume link shows up once public/resume.pdf is added
const hasResume = existsSync(join(process.cwd(), 'public', 'resume.pdf'));
---

<footer>
  <nav aria-label={t(lang, 'footer.nav')}>
    <a href="https://www.linkedin.com/in/yu-chang-556222196/" target="_blank" rel="noopener">LinkedIn</a>
    <span aria-hidden="true">/</span>
    <button type="button" class="copy" data-copy-email={EMAIL} title={EMAIL}>Email</button>
    {
      hasResume && (
        <>
          <span aria-hidden="true">/</span>
          <a href="/resume.pdf" target="_blank" rel="noopener">{t(lang, 'footer.resume')}</a>
        </>
      )
    }
  </nav>
  <div class="snackbar" role="status" aria-live="polite" data-snackbar>{t(lang, 'footer.copied')}</div>
</footer>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  a:hover,
  .copy:hover {
    color: var(--color-text);
  }
  /* Looks like the links next to it */
  .copy {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  /* "Copied" message at the bottom of the window */
  .snackbar {
    position: fixed;
    left: 50%;
    bottom: 32px;
    z-index: 20;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.875rem;
    font-weight: 500;
    box-shadow: var(--shadow-float);
    pointer-events: none;
    opacity: 0;
    translate: -50% 12px;
    transition:
      opacity 200ms var(--ease-out),
      translate 200ms var(--ease-out);
  }
  .snackbar.is-visible {
    opacity: 1;
    translate: -50% 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .snackbar {
      transition: opacity 200ms linear;
      translate: -50% 0;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-snackbar]');
  let timer = 0;

  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // Older browsers or no clipboard permission
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      const ok = document.execCommand('copy');
      area.remove();
      return ok;
    }
  };

  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      if (!(await copy(btn.dataset.copyEmail!)) || !bar) return;
      // Re-announce even if it's already showing
      bar.classList.remove('is-visible');
      void bar.offsetWidth;
      bar.classList.add('is-visible');
      clearTimeout(timer);
      timer = window.setTimeout(() => bar.classList.remove('is-visible'), 2000);
    }),
  );
</script>
