---
import { getCollection } from 'astro:content';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const items = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
---

<section aria-labelledby="tools-title">
  <h2 id="tools-title" class="section-title">{t(lang, 'section.tools')}</h2>
  <ul class="list">
    {
      items.map(({ id, data }) => (
        <li>
          <a href={data.link ?? `/tools/${id}`} class="row">
            <span class="title">{t(lang, `tools.${id}.title`)}</span>
            <span class="type">{t(lang, `tools.${id}.type`)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-line);
  }
  li {
    border-top: 1px solid var(--color-line);
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 12px;
    margin: 0 -12px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color var(--duration) var(--ease-out);
  }
  .row:hover {
    background: var(--color-surface);
  }
  .title {
    font-weight: 500;
  }
  .row:hover .title {
    text-decoration: underline;
  }
  .type {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
</style>
