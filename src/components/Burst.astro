---
/*
  A few hand-drawn strokes bursting from the top-left of a section heading.
  Same pen as the headline's loop and underline. Goes inside the heading, before the text.
  On the first homepage view of a visit (html.draw-title), the strokes draw in when the heading scrolls into view.
*/

// Strokes radiate from the bottom-right corner (24, 24), each a little different, like a quick pen flick
const strokes = [
  { angle: 192, from: 6.5, to: 12 },
  { angle: 227, from: 7.5, to: 14 },
  { angle: 263, from: 7, to: 14.5 },
  { angle: 300, from: 7.5, to: 12.5 },
];
const paths = strokes.map(({ angle, from, to }) => {
  const r = (angle * Math.PI) / 180;
  const p = (d: number) => `${(24 + Math.cos(r) * d).toFixed(1)} ${(24 + Math.sin(r) * d).toFixed(1)}`;
  return `M${p(to)} L${p(from)}`;
});
---

<svg class="burst" viewBox="0 0 24 24" aria-hidden="true">
  {paths.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}
</svg>

<style>
  .burst {
    position: absolute;
    left: -1.55em;
    top: -1.4em;
    width: 1.75em;
    height: 1.75em;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .burst path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  /* First view: hidden until the heading comes into view, then drawn one flick after another */
  :global(html.draw-title) .burst path {
    stroke-dashoffset: 1;
  }
  :global(html.draw-title) .burst.go path {
    animation: burst-draw 180ms cubic-bezier(0.55, 0.1, 0.35, 1) forwards;
    /* Waits for the heading to finish rising in (and, on the first screen, for the headline marks) */
    animation-delay: calc(var(--wait, 900ms) + var(--i) * 70ms);
  }
  @keyframes burst-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (max-width: 520px) {
    .burst {
      left: -1.15em;
      top: -1.1em;
      width: 1.35em;
      height: 1.35em;
      stroke-width: 1.7;
    }
  }
</style>

<script>
  // Draw each burst once, when its heading scrolls into view
  const bursts = document.querySelectorAll('.burst');
  if (document.documentElement.classList.contains('draw-title') && !('IntersectionObserver' in window)) {
    bursts.forEach((b) => b.classList.add('go'));
  } else if (document.documentElement.classList.contains('draw-title')) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          // Let the heading finish rising in first; on the first screen, also wait for the headline's loop and underline
          const el = e.target as SVGElement;
          el.style.setProperty('--wait', `${Math.max(900, 2000 - performance.now())}ms`);
          el.classList.add('go');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    bursts.forEach((b) => io.observe(b));
  }
</script>
