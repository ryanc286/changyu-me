---
/*
  Inline company link with a hover card (logo + one-line context).
  Desktop: card shows on hover or keyboard focus. Touch: plain link.
*/
interface Props {
  name: string;
  href: string;
  logo: string; // base name in /images/logos, e.g. "paypay"
  logoWidth: number; // natural size of the cropped logo
  logoHeight: number;
  description: string;
  logoDisplayHeight?: number; // visual size in the card (wordmark-only logos read larger)
}

const { name, href, logo, logoWidth, logoHeight, description, logoDisplayHeight = 20 } = Astro.props;
const id = `org-${logo}`;
const height = logoDisplayHeight;
const width = Math.round((logoWidth / logoHeight) * height);
---

<span class="org">
  <a href={href} target="_blank" rel="noopener" aria-describedby={id}>{name}</a>
  <span class="card" id={id} role="tooltip">
    <img class="logo logo-light" src={`/images/logos/${logo}-light.png`} alt="" width={width} height={height} style={`height:${height}px`} />
    <img class="logo logo-dark" src={`/images/logos/${logo}-dark.png`} alt="" width={width} height={height} style={`height:${height}px`} loading="lazy" />
    <span class="desc">{description}</span>
  </span>
</span>

<style>
  .org {
    position: relative;
    display: inline-block;
  }
  .card {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    /* Hidden cards use display: none so they never widen the page.
       allow-discrete lets display animate together with opacity. */
    .card {
      position: absolute;
      bottom: calc(100% + 10px);
      left: 50%;
      z-index: 20;
      width: max-content;
      max-width: min(280px, calc(100vw - 24px));
      display: none;
      flex-direction: column;
      gap: 8px;
      padding: 14px 16px;
      background: var(--color-bg);
      border: 1px solid var(--color-line-strong);
      border-radius: 10px;
      box-shadow: var(--shadow-float);
      line-height: 1.45;
      font-weight: 400;
      white-space: normal;
      pointer-events: none;
      opacity: 0;
      transform: translate(calc(-50% + var(--dx, 0px)), 4px);
      transition:
        opacity var(--duration) var(--ease-out),
        transform var(--duration) var(--ease-out),
        display var(--duration) allow-discrete;
    }
    .org:hover .card,
    .org:focus-within .card {
      display: flex;
      opacity: 1;
      transform: translate(calc(-50% + var(--dx, 0px)), 0);
      transition-delay: 80ms;
    }
    @starting-style {
      .org:hover .card,
      .org:focus-within .card {
        opacity: 0;
        transform: translate(calc(-50% + var(--dx, 0px)), 4px);
      }
    }
  }

  .logo {
    width: auto;
    align-self: flex-start;
  }
  .logo-dark {
    display: none;
  }
  :global([data-theme='dark']) .logo-light {
    display: none;
  }
  :global([data-theme='dark']) .logo-dark {
    display: block;
  }
  .desc {
    font-size: var(--text-sm);
    color: var(--color-text-body);
  }
</style>

<script>
  // Keep a shown card inside the window: nudge it in when it would cross an edge.
  const MARGIN = 12;
  document.querySelectorAll<HTMLElement>('.org').forEach((org) => {
    const card = org.querySelector<HTMLElement>('.card');
    if (!card) return;
    const fit = () => {
      card.style.setProperty('--dx', '0px');
      requestAnimationFrame(() => {
        const r = card.getBoundingClientRect();
        if (!r.width) return;
        let dx = 0;
        if (r.right > innerWidth - MARGIN) dx = innerWidth - MARGIN - r.right;
        if (r.left + dx < MARGIN) dx = MARGIN - r.left;
        card.style.setProperty('--dx', `${Math.round(dx)}px`);
      });
    };
    org.addEventListener('pointerenter', fit);
    org.addEventListener('focusin', fit);
  });
</script>
