---
/*
  Inline company link with a hover card (logo + one-line context).
  Desktop: card shows on hover or keyboard focus. Touch: plain link.
*/
interface Props {
  name: string;
  href: string;
  logo: string; // base name in /images/logos, e.g. "paypay"
  logoWidth: number; // natural size of the cropped logo
  logoHeight: number;
  description: string;
  logoDisplayHeight?: number; // visual size in the card (wordmark-only logos read larger)
}

const { name, href, logo, logoWidth, logoHeight, description, logoDisplayHeight = 20 } = Astro.props;
const id = `org-${logo}`;
const height = logoDisplayHeight;
const width = Math.round((logoWidth / logoHeight) * height);
---

<span class="org">
  <a href={href} target="_blank" rel="noopener" aria-describedby={id}>{name}</a>
  <span class="card" id={id} role="tooltip">
    <picture>
      <source srcset={`/images/logos/${logo}-dark.png`} media="(prefers-color-scheme: dark)" />
      <img src={`/images/logos/${logo}-light.png`} alt="" width={width} height={height} style={`height:${height}px`} />
    </picture>
    <span class="desc">{description}</span>
  </span>
</span>

<style>
  .org {
    position: relative;
    display: inline-block;
  }
  .card {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .card {
      position: absolute;
      bottom: calc(100% + 10px);
      left: 50%;
      z-index: 20;
      width: max-content;
      max-width: 280px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 14px 16px;
      background: var(--color-bg);
      border: 1px solid var(--color-line);
      border-radius: 10px;
      box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
      line-height: 1.45;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transform: translate(-50%, 4px);
      transition:
        opacity var(--duration) var(--ease-out),
        transform var(--duration) var(--ease-out),
        visibility 0s linear var(--duration);
    }
    .org:hover .card,
    .org:focus-within .card {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 0);
      transition-delay: 80ms, 80ms, 0s;
    }
  }

  img {
    width: auto;
  }
  .desc {
    font-size: var(--text-sm);
    color: var(--color-text-body);
  }
</style>
