---
/*
  The homepage headline text (goes inside the h1) with two pen marks drawn on it:
  a loose, messy loop around "complex" and one clean stroke under "simple".
  The words to mark are found in the copy (copy.json / Notion), so the text itself stays editable.
  The marks draw themselves once per visit; otherwise (case backdrop, reduced motion, repeat visits) they just show.
*/
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const text = t(lang, 'home.title');

// Words to mark, plus a rough box size for each in em, so the SVG isn't stretched out of shape
const marks: Record<Lang, { circle: string; line: string; circleEm: number; lineEm: number }> = {
  en: { circle: 'complex', line: 'simple', circleEm: 4.1, lineEm: 3.15 },
  'zh-tw': { circle: '複雜', line: '簡單易用', circleEm: 2, lineEm: 4 },
};
const m = marks[lang];

// SVG units: 100 = 1em
const U = 100;

// A hand-drawn loop: a bit more than one turn, uneven, ends overshooting where it started
function loopPath(w: number, h: number) {
  const cx = w / 2;
  const cy = h / 2;
  const pts: [number, number][] = [];
  const turns = 1.18;
  const steps = 18;
  // Fixed wobble so the drawing is the same every build
  const wob = [0.02, -0.04, 0.03, 0.05, -0.02, 0.04, -0.03, 0.02, 0.05, -0.02, 0.03, -0.04, 0.02, 0.04, 0.01, -0.03, 0.03, 0.05, 0.07];
  for (let i = 0; i <= steps; i++) {
    const a = Math.PI * 1.2 + (i / steps) * turns * Math.PI * 2;
    const grow = 1 + (i / steps) * 0.05; // second pass sits a touch wider
    const r = 1 + wob[i % wob.length];
    // Squarer than an ellipse, so it clears the corners of the word
    const sq = (v: number) => Math.sign(v) * Math.abs(v) ** 0.7;
    pts.push([cx + sq(Math.cos(a)) * (w / 2) * r * grow, cy + sq(Math.sin(a)) * (h / 2) * r * grow]);
  }
  return smooth(pts);
}

// One confident stroke that lifts slightly at the end
function linePath(w: number) {
  return smooth([
    [0, 14],
    [w * 0.35, 11],
    [w * 0.7, 9],
    [w, 4],
  ]);
}

// Catmull-Rom through the points, as cubic curves
function smooth(p: [number, number][]) {
  const f = (n: number) => n.toFixed(1);
  let d = `M${f(p[0][0])} ${f(p[0][1])}`;
  for (let i = 0; i < p.length - 1; i++) {
    const p0 = p[i - 1] ?? p[i];
    const p1 = p[i];
    const p2 = p[i + 1];
    const p3 = p[i + 2] ?? p2;
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
  }
  return d;
}

// The loop box is the word plus some room around it
const cw = (m.circleEm + 0.44) * U;
const ch = 1.4 * U;
const lw = (m.lineEm + 0.1) * U;
const lh = 18;

// Split the headline around the two words
type Part = { text: string; kind?: 'circle' | 'line' };
let parts: Part[] = [{ text }];
for (const [word, kind] of [
  [m.circle, 'circle'],
  [m.line, 'line'],
] as const) {
  parts = parts.flatMap((part) => {
    if (part.kind) return [part];
    const i = part.text.indexOf(word);
    if (i < 0) return [part];
    return [
      { text: part.text.slice(0, i) },
      { text: word, kind },
      { text: part.text.slice(i + word.length) },
    ].filter((x) => x.text);
  });
}
---

  {
    parts.map((p) =>
      p.kind === 'circle' ? (
        <span class="mark circled">
          {p.text}
          <svg class="loop" viewBox={`0 0 ${cw} ${ch}`} aria-hidden="true">
            <path d={loopPath(cw, ch)} pathLength="1" />
          </svg>
        </span>
      ) : p.kind === 'line' ? (
        <span class="mark">
          {p.text}
          <svg class="line" viewBox={`0 0 ${lw} ${lh}`} aria-hidden="true">
            <path d={linePath(lw)} pathLength="1" />
          </svg>
        </span>
      ) : (
        p.text
      ),
    )
  }

<script is:inline>
  /* Draw the marks only on a first homepage view in this visit. Runs before the headline paints. */
  (() => {
    const html = document.documentElement;
    if (html.dataset.page === 'case') return;
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (sessionStorage.getItem('titleDrawn')) return;
      sessionStorage.setItem('titleDrawn', '1');
    } catch {
      return;
    }
    html.classList.add('draw-title');
  })();
</script>

<style>
  .mark {
    position: relative;
    white-space: nowrap;
  }
  .mark svg {
    position: absolute;
    overflow: visible;
    pointer-events: none;
    fill: none;
    stroke: var(--color-text-muted);
    stroke-linecap: round;
    stroke-linejoin: round;
    /* About 2.5px on desktop; the marks scale with the headline */
    stroke-width: 9;
  }
  /* A little air on both sides so the loop doesn't run through the next letters */
  .circled {
    margin-inline: 0.16em;
  }
  .loop {
    left: -0.22em;
    top: -0.13em;
    width: calc(100% + 0.44em);
    height: 1.4em;
    rotate: -2deg;
  }
  .line {
    left: 0;
    top: calc(100% - 0.02em);
    width: calc(100% + 0.1em);
    height: 0.18em;
  }
  .mark path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  /* Pen on paper: loop first, then the underline, quick start and a soft finish */
  :global(html.draw-title) .mark path {
    stroke-dashoffset: 1;
    animation: draw 650ms cubic-bezier(0.55, 0.1, 0.35, 1) 450ms forwards;
  }
  :global(html.draw-title) .line path {
    animation-duration: 380ms;
    animation-delay: 1200ms;
  }
  /* When the page rises in, wait for the headline to settle before drawing */
  :global(html.reveal.draw-title) .mark path {
    animation-delay: 750ms;
  }
  :global(html.reveal.draw-title) .line path {
    animation-delay: 1500ms;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
