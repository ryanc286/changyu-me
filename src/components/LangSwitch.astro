---
/*
  EN / 中 segmented switch. Each option is a real link to the same page
  in that language, so it works without JavaScript and can be shared.
*/
import { languages, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Partial<Record<Lang, string>>;
}
const { lang, alternates } = Astro.props;
const options = (Object.keys(languages) as Lang[]).filter((l) => alternates[l]);
---

<nav class="lang-switch" aria-label={t(lang, 'lang.switch')}>
  {
    options.map((l) =>
      l === lang ? (
        <span class="opt is-active" aria-current="true" lang={languages[l].htmlLang} style={`view-transition-name: lang-${l}`}>
          <span class="pill" aria-hidden="true" />
          {languages[l].label}
        </span>
      ) : (
        <a
          class="opt"
          style={`view-transition-name: lang-${l}`}
          href={alternates[l]}
          hreflang={languages[l].htmlLang}
          lang={languages[l].htmlLang}
          aria-label={languages[l].name}>
          {languages[l].label}
        </a>
      ),
    )
  }
</nav>

<style>
  .lang-switch {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
  .opt {
    min-width: 30px;
    height: 20px;
    padding: 0 8px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--duration) var(--ease-out),
      background-color var(--duration) var(--ease-out);
  }
  /* Bigger tap area without changing the look */
  a.opt {
    position: relative;
  }
  a.opt::after {
    content: '';
    position: absolute;
    inset: -12px -4px;
  }
  a.opt:hover {
    color: var(--color-text);
  }
  .is-active {
    position: relative;
    isolation: isolate;
    color: #1a1a1a;
  }
  :global([data-theme='dark']) .is-active {
    color: #141413;
  }
  /* The white pill is its own element so it can slide between pages
     (view transition) while the labels stay put. */
  .pill {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 999px;
    background: #ffffff;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.18);
    view-transition-name: lang-pill;
  }
  :global([data-theme='dark']) .pill {
    background: #f2f2ef;
  }
</style>
