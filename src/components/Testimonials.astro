---
/*
  "What people I've worked with say": short quotes in the same list style as Work and Tools.
  Text lives in copy.json (testimonials.<n>.quote / .by), synced with Notion.
  A blank line in a quote starts a new paragraph. {PAYPAY} / {CAROUSELL} / {AAPD} in .by become company links.
*/
import CopyWithLinks from './CopyWithLinks.astro';
import { t, tOpt, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const items: { quote: string[]; by: string }[] = [];
for (let n = 1; tOpt(lang, `testimonials.${n}.quote`); n++) {
  items.push({
    quote: t(lang, `testimonials.${n}.quote`).split(/\n\s*\n/),
    by: t(lang, `testimonials.${n}.by`),
  });
}
---

{
  items.length > 0 && (
    <section aria-labelledby="testimonials-title">
      <h2 id="testimonials-title" class="section-title">
        {t(lang, 'section.testimonials')}
      </h2>
      <ul class="list">
        {items.map((it) => (
          <li>
            <figure>
              <blockquote>
                {it.quote.map((para) => (
                  <p>{para}</p>
                ))}
              </blockquote>
              <figcaption>
                <CopyWithLinks lang={lang} text={it.by} />
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-line);
  }
  li {
    border-top: 1px solid var(--color-line);
    padding: 20px 0;
  }
  figure {
    margin: 0;
  }
  blockquote {
    margin: 0;
  }
  blockquote p {
    margin: 0;
    color: var(--color-text-body);
  }
  blockquote p + p {
    margin-top: var(--space-2);
  }
  figcaption {
    margin-top: 10px;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
