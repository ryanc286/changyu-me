---
/*
  "What people I've worked with say": five people in a row (photo, name, title, company).
  Wider screens: click someone and their words open below the row; their card and the words join into one tab-and-panel shape.
  Phones (600px and under): tap someone to read their words in a half sheet.
  Text lives in copy.json (testimonials.<n>.quote, testimonials.<n>.by = "Name, Title · Company"),
  synced with Notion. Photos: public/images/people/person-<n>.webp.
*/
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { t, tOpt, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const closeLabel = lang === 'zh-tw' ? '關閉' : 'Close';

const items: { quote: string; name: string; title: string; company: string; photo?: string }[] = [];
for (let n = 1; tOpt(lang, `testimonials.${n}.quote`); n++) {
  const by = t(lang, `testimonials.${n}.by`);
  const [who, company = ''] = by.split(' · ');
  const [name, ...rest] = who.split(/[,，]\s*/);
  const photo = `/images/people/person-${n}.webp`;
  items.push({
    quote: t(lang, `testimonials.${n}.quote`).replace(/\n\s*\n/g, ' '),
    name: name.trim(),
    title: rest.join(', ').trim(),
    company: company.trim(),
    photo: existsSync(join(process.cwd(), 'public', photo)) ? photo : undefined,
  });
}
---

{
  items.length > 0 && (
    <section aria-labelledby="testimonials-title" data-people>
      <h2 id="testimonials-title" class="section-title">
        {t(lang, 'section.testimonials')}
      </h2>
      <ul class="people">
        {items.map((it, i) => (
          <li>
            <button
              type="button"
              class="person"
              data-quote={it.quote}
              data-name={it.name}
              data-role={[it.title, it.company].filter(Boolean).join(' · ')}
              data-photo={it.photo}
              aria-describedby={`quote-${i}`}
              aria-expanded="false"
              aria-controls="people-quote"
            >
              <span class="photo">{it.photo && <img src={it.photo} alt="" loading="lazy" />}</span>
              <span class="name">{it.name}</span>
              <span class="role">{it.title}</span>
              <span class="role">{it.company}</span>
            </button>
            {/* Screen readers get the quote right with the person */}
            <span class="sr-only" id={`quote-${i}`}>
              {it.quote}
            </span>
          </li>
        ))}
      </ul>
      {/* Phones: a half sheet with the chosen person's words */}
      <dialog class="tsheet" aria-labelledby="tsheet-name">
        <div class="scrim" data-close />
        {/* Focus lands on the sheet itself, not the close button, so no ring flashes on open */}
        <div class="panel" tabindex="-1" autofocus>
          <div class="drag">
            <div class="grab" aria-hidden="true"><span /></div>
            <div class="who">
              <span class="photo"><img alt="" /></span>
              <span>
                <span class="name" id="tsheet-name" />
                <span class="role" />
              </span>
            </div>
            <button type="button" class="close" aria-label={closeLabel} data-close>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            </button>
          </div>
          <p class="quote" />
        </div>
      </dialog>
      {/* Wider screens: the chosen person's words open below the row.
          The tab is drawn behind the chosen card and runs into the panel, so the two read as one shape. */}
      <span class="tab" aria-hidden="true" />
      <div class="expand" id="people-quote">
        <div class="expand-inner">
          <div class="bubble">
            <p class="bubble-quote" aria-live="polite" />
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  /* A sideways row: four and a half people show, the half hints there's more */
  .people {
    --gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .people::-webkit-scrollbar {
    display: none;
  }
  .people li {
    /* Keeps each hidden screen reader quote inside the row, so it can't widen the page */
    position: relative;
    flex: 0 0 calc((100% - 4 * var(--gap)) / 4.5);
    margin: 0;
    scroll-snap-align: start;
  }
  /* Dragging with a mouse */
  .people.dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }
  .people.dragging .person {
    pointer-events: none;
  }
  .person {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 16px 6px;
    border: 0;
    border-radius: 14px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: center;
    cursor: default;
    transition: background-color var(--duration) var(--ease-out);
  }
  .photo {
    display: block;
    width: 72px;
    height: 72px;
    margin-bottom: 12px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-surface);
  }
  /* Photos sit in the site's warm gray until you point at someone */
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) sepia(0.18) contrast(0.95) brightness(1.04);
    transition: filter 400ms var(--ease-out);
  }
  .name {
    font-weight: 500;
    line-height: 1.35;
  }
  .role {
    margin-top: 2px;
    font-size: var(--text-sm);
    line-height: 1.35;
    color: var(--color-text-muted);
  }
  .tsheet {
    display: none;
  }

  /* Wider screens: the words open below the row as a panel joined to the chosen card */
  [data-people] {
    position: relative;
  }
  .people {
    position: relative;
    z-index: 1;
  }
  .expand {
    height: 0;
    overflow: hidden;
    transition: height 300ms var(--ease-out);
  }
  .expand-inner {
    /* The gap the tab bridges between the row and the panel */
    padding-top: 12px;
  }
  .bubble {
    padding: 20px 24px;
    border-radius: var(--tl, 14px) var(--tr, 14px) 14px 14px;
    background: var(--color-surface);
  }
  /* The tab sits behind the chosen card and reaches 2px into the panel, so no hairline can show where they meet */
  .tab {
    position: absolute;
    z-index: 0;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-radius: 14px 14px 0 0;
    background: var(--color-surface);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 150ms ease,
      left 300ms var(--ease-out),
      width 300ms var(--ease-out);
  }
  .tab.show {
    opacity: 1;
  }
  .tab.still {
    transition: opacity 150ms ease;
  }
  /* Soft inside corners where the tab meets the panel; also run 2px into the panel */
  .tab::before,
  .tab::after {
    content: '';
    position: absolute;
    bottom: 0;
    width: 12px;
    height: 14px;
  }
  .tab::before {
    left: -12px;
    background: radial-gradient(circle at 0 0, transparent 12px, var(--color-surface) 12.5px);
  }
  .tab::after {
    right: -12px;
    background: radial-gradient(circle at 100% 0, transparent 12px, var(--color-surface) 12.5px);
  }
  .tab.flush-l::before,
  .tab.flush-r::after {
    display: none;
  }
  .bubble-quote {
    max-width: 68ch;
    margin: 0;
    color: var(--color-text-body);
    transition: opacity 150ms ease;
  }
  .bubble-quote.swap {
    opacity: 0;
  }
  .person {
    cursor: pointer;
  }
  /* The tab behind the card gives it its color */
  .person.on {
    background: none;
  }
  .person.on .photo img {
    filter: none;
  }

  /* Pointing at someone hints they can be clicked */
  @media (hover: hover) and (pointer: fine) {
    .person:hover,
    .person:focus-visible {
      background: color-mix(in srgb, var(--color-surface) 60%, transparent);
    }
    .person.on:hover {
      background: none;
    }
  }

  /* Phones: a sideways row, tap to read in a half sheet */
  @media (max-width: 600px) {
    .people {
      --gap: 4px;
    }
    .people li {
      flex-basis: 112px;
      display: flex;
    }
    /* Half sheet: same look as the case study sheet on phones */
    .tsheet[open] {
      display: block;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      /* clip, not hidden: focusing inside must never scroll the sheet into place before it slides */
      overflow: clip;
    }
    .tsheet::backdrop {
      background: transparent;
    }
    .scrim {
      position: absolute;
      inset: 0;
      background: rgb(0 0 0 / 0.32);
      opacity: 0;
      /* Closing is quicker than opening, like iOS sheets */
      transition: opacity 220ms ease;
    }
    .panel {
      --sheet-bg: var(--color-bg);
      position: absolute;
      inset: auto 0 0;
      display: flex;
      flex-direction: column;
      max-height: 60dvh;
      border-radius: 24px 24px 0 0;
      background: var(--sheet-bg);
      box-shadow: 0 -6px 28px rgb(0 0 0 / 0.18);
      outline: none;
      transform: translateY(100%);
      /* Closing: picks up speed as it leaves */
      transition: transform 240ms cubic-bezier(0.4, 0, 1, 1);
    }
    :global(:root[data-theme='dark']) .scrim {
      background: rgb(0 0 0 / 0.55);
    }
    :global(:root[data-theme='dark']) .panel {
      --sheet-bg: #1a1a19;
      box-shadow: 0 -6px 28px rgb(0 0 0 / 0.6), inset 1px 1px 0 0 rgb(255 255 255 / 0.06);
    }
    /* Opening: the iOS sheet curve, fast out and a long soft settle */
    .tsheet.in .scrim {
      opacity: 1;
      transition: opacity 360ms ease;
    }
    .tsheet.in .panel {
      transform: none;
      transition: transform 480ms cubic-bezier(0.32, 0.72, 0, 1);
    }
    /* The words follow the sheet up a moment later */
    .who,
    .quote {
      opacity: 0;
      translate: 0 10px;
      transition:
        opacity 160ms ease,
        translate 160ms ease;
    }
    .tsheet.in .who,
    .tsheet.in .quote {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 320ms ease 80ms,
        translate 480ms cubic-bezier(0.32, 0.72, 0, 1) 80ms;
    }
    .tsheet.in .quote {
      transition-delay: 130ms;
    }
    /* Tapping a person gives a small press */
    .person {
      transition:
        background-color var(--duration) var(--ease-out),
        scale 160ms var(--ease-out);
    }
    .person:active {
      scale: 0.96;
    }
    /* The top part is the drag area: pull down to close */
    .drag {
      position: relative;
      flex: none;
      padding: 28px 56px 0 20px;
      touch-action: none;
    }
    .grab {
      position: absolute;
      inset: 0 0 auto;
      display: flex;
      justify-content: center;
      padding-top: 8px;
    }
    .grab span {
      width: 36px;
      height: 4px;
      border-radius: 2px;
      background: var(--color-line-strong);
    }
    .who {
      display: flex;
      align-items: center;
      gap: 12px;
      text-align: left;
    }
    .who .photo {
      flex: none;
      width: 48px;
      height: 48px;
      margin: 0;
    }
    .who .photo img {
      filter: none;
    }
    .who .name,
    .who .role {
      display: block;
    }
    .close {
      position: absolute;
      top: 20px;
      right: 16px;
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--color-surface);
      color: var(--color-text-muted);
      cursor: pointer;
    }
    .quote {
      margin: 0;
      padding: 16px 20px calc(24px + env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      color: var(--color-text-body);
      line-height: var(--leading, 1.6);
    }
    :global(html.sheet-open) {
      overflow: hidden;
    }
    .expand,
    .tab {
      display: none;
    }
    .person.on {
      background: var(--color-surface);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo img,
    .expand,
    .tab,
    .bubble-quote,
    .scrim,
    .panel,
    .tsheet .who,
    .tsheet .quote {
      transition: none !important;
    }
    .who,
    .quote {
      translate: none;
    }
    .person:active {
      scale: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-people]').forEach((section) => {
    const people = [...section.querySelectorAll<HTMLButtonElement>('.person')];
    const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const row = section.querySelector<HTMLElement>('.people')!;

    // Tap (phones): open a half sheet with this person's words
    const sheet = section.querySelector<HTMLDialogElement>('.tsheet')!;
    const panel = sheet.querySelector<HTMLElement>('.panel')!;
    const drag = sheet.querySelector<HTMLElement>('.drag')!;
    const img = sheet.querySelector<HTMLImageElement>('.photo img')!;
    const phone = matchMedia('(max-width: 600px)');
    let closing = false;
    const open = (p: HTMLElement) => {
      people.forEach((o) => o.classList.toggle('on', o === p));
      sheet.querySelector('.name')!.textContent = p.dataset.name ?? '';
      sheet.querySelector('.role')!.textContent = p.dataset.role ?? '';
      sheet.querySelector('.quote')!.textContent = p.dataset.quote ?? '';
      sheet.querySelector<HTMLElement>('.quote')!.scrollTop = 0;
      if (p.dataset.photo) img.src = p.dataset.photo;
      img.hidden = !p.dataset.photo;
      closing = false;
      panel.style.transform = '';
      sheet.showModal();
      document.documentElement.classList.add('sheet-open');
      panel.getBoundingClientRect(); // start from below the screen
      sheet.classList.add('in');
    };
    const close = () => {
      if (closing || !sheet.open) return;
      closing = true;
      sheet.classList.remove('in');
      panel.style.transition = '';
      panel.style.transform = '';
      const done = () => {
        if (!closing) return;
        sheet.close();
        document.documentElement.classList.remove('sheet-open');
        people.forEach((o) => o.classList.remove('on'));
        closing = false;
      };
      if (reduce) done();
      else setTimeout(done, 260);
    };
    people.forEach((p) =>
      p.addEventListener('click', () => {
        if (phone.matches) open(p);
        else toggle(p);
      }),
    );
    sheet.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
    sheet.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });

    // Pull the top part down to close; a short fast flick works too
    let startY = 0, dy = 0, lastY = 0, lastT = 0, speed = 0;
    const onMove = (e: PointerEvent) => {
      dy = Math.max(0, e.clientY - startY);
      const now = performance.now();
      speed = (e.clientY - lastY) / Math.max(1, now - lastT);
      lastY = e.clientY;
      lastT = now;
      panel.style.transform = `translateY(${dy}px)`;
    };
    const onUp = () => {
      removeEventListener('pointermove', onMove);
      removeEventListener('pointerup', onUp);
      removeEventListener('pointercancel', onUp);
      panel.style.transition = '';
      if (dy > 80 || (dy > 10 && speed > 0.5)) close();
      else panel.style.transform = '';
    };
    drag.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('.close')) return;
      startY = lastY = e.clientY;
      lastT = performance.now();
      dy = speed = 0;
      panel.style.transition = 'none';
      addEventListener('pointermove', onMove);
      addEventListener('pointerup', onUp);
      addEventListener('pointercancel', onUp);
    });
    // Wider screens: click to open their words below the row; click again or Esc to close
    const expand = section.querySelector<HTMLElement>('.expand')!;
    const inner = expand.querySelector<HTMLElement>('.expand-inner')!;
    const bubble = expand.querySelector<HTMLElement>('.bubble')!;
    const tab = section.querySelector<HTMLElement>('.tab')!;
    const words = expand.querySelector<HTMLElement>('.bubble-quote')!;
    let current: HTMLElement | null = null;
    let swapTimer = 0;
    const select = (p: HTMLElement | null) => {
      current = p;
      people.forEach((o) => {
        o.classList.toggle('on', o === p);
        o.setAttribute('aria-expanded', String(o === p));
      });
    };
    // Draw the tab behind the chosen card, down into the panel; square the panel corner when they line up
    const placeTab = () => {
      if (!current) {
        tab.classList.remove('show');
        return;
      }
      const sec = section.getBoundingClientRect();
      const c = current.getBoundingClientRect();
      const r = row.getBoundingClientRect();
      const bb = bubble.getBoundingClientRect();
      const left = Math.max(c.left, r.left);
      const right = Math.min(c.right, r.right);
      if (right - left < 28) {
        tab.classList.remove('show');
        bubble.style.setProperty('--tl', '14px');
        bubble.style.setProperty('--tr', '14px');
        return;
      }
      tab.style.left = `${left - sec.left}px`;
      tab.style.width = `${right - left}px`;
      tab.style.top = `${c.top - sec.top}px`;
      tab.style.height = `${bb.top - c.top + 2}px`;
      const flushL = left - bb.left < 14;
      const flushR = bb.right - right < 14;
      tab.classList.toggle('flush-l', flushL);
      tab.classList.toggle('flush-r', flushR);
      // A square corner where the tab sits at the panel's edge; round otherwise
      bubble.style.setProperty('--tl', flushL ? '0px' : '14px');
      bubble.style.setProperty('--tr', flushR ? '0px' : '14px');
      tab.classList.add('show');
    };
    const fit = () => {
      expand.style.height = `${inner.offsetHeight}px`;
    };
    const toggle = (p: HTMLElement) => {
      clearTimeout(swapTimer);
      if (current === p) {
        expand.style.height = '0px';
        select(null);
        placeTab();
        return;
      }
      const wasOpen = !!current;
      select(p);
      if (!wasOpen) {
        // Open: set the words, place the tab without sliding, then grow
        words.textContent = p.dataset.quote ?? '';
        words.classList.remove('swap');
        tab.classList.add('still');
        placeTab();
        tab.getBoundingClientRect();
        tab.classList.remove('still');
        fit();
        return;
      }
      // Switch: the tab slides over, the words fade out and back in, the height follows
      placeTab();
      words.classList.add('swap');
      swapTimer = window.setTimeout(
        () => {
          words.textContent = p.dataset.quote ?? '';
          words.classList.remove('swap');
          fit();
        },
        reduce ? 0 : 150,
      );
    };
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && current && !phone.matches) {
        const p = current;
        toggle(p);
        p.focus();
      }
    });
    row.addEventListener(
      'scroll',
      () => {
        tab.classList.add('still');
        placeTab();
        requestAnimationFrame(() => tab.classList.remove('still'));
      },
      { passive: true },
    );
    addEventListener('resize', () => {
      if (!current) return;
      if (phone.matches) {
        expand.style.height = '0px';
        select(null);
        placeTab();
        return;
      }
      tab.classList.add('still');
      placeTab();
      fit();
      requestAnimationFrame(() => tab.classList.remove('still'));
    });

    if (!canHover) return;

    // Mouse users can drag the row sideways (trackpads scroll it natively)
    let downX = 0, startLeft = 0, moved = false;
    row.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      downX = e.clientX;
      startLeft = row.scrollLeft;
      moved = false;
      const move = (ev: PointerEvent) => {
        const dx = ev.clientX - downX;
        if (!moved && Math.abs(dx) < 4) return;
        if (!moved) {
          moved = true;
          row.classList.add('dragging');
        }
        row.scrollLeft = startLeft - dx;
      };
      const up = () => {
        removeEventListener('pointermove', move);
        removeEventListener('pointerup', up);
        if (!moved) return;
        // Let it snap to the nearest person again
        const left = row.scrollLeft;
        row.classList.remove('dragging');
        row.scrollLeft = left;
      };
      addEventListener('pointermove', move);
      addEventListener('pointerup', up);
    });
  });
</script>
