---
/*
  "What people I've worked with say": five people in a row (photo, name, title, company).
  Wider screens: click someone and their words open below the row, with a notch pointing at them.
  Phones (600px and under): tap someone to read their words in a half sheet.
  Text lives in copy.json (testimonials.<n>.quote, testimonials.<n>.by = "Name, Title · Company"),
  synced with Notion. Photos: public/images/people/person-<n>.webp.
  Each person shows as a black and white pixel portrait (src/data/pixel-people.json, 36 × 36).
  Choosing someone sharpens it into their photo in a few steps (person-<n>-px12/24/48.png, then the photo).
*/
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Burst from './Burst.astro';
import pixelPeople from '../data/pixel-people.json';
import { t, tOpt, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const closeLabel = lang === 'zh-tw' ? '關閉' : 'Close';

const items: { quote: string; name: string; title: string; company: string; photo?: string; pixel?: string; n: number }[] = [];
const pixels = pixelPeople.paths as Record<string, string>;
// The steps between the pixel portrait and the photo, coarse to fine
const STEPS = [12, 24, 48];
const stepSrc = (n: number, k: number) => `/images/people/person-${n}-px${k}.png`;
for (let n = 1; tOpt(lang, `testimonials.${n}.quote`); n++) {
  const by = t(lang, `testimonials.${n}.by`);
  const [who, company = ''] = by.split(' · ');
  const [name, ...rest] = who.split(/[,，]\s*/);
  const photo = `/images/people/person-${n}.webp`;
  items.push({
    quote: t(lang, `testimonials.${n}.quote`).replace(/\n\s*\n/g, ' '),
    name: name.trim(),
    title: rest.join(', ').trim(),
    company: company.trim(),
    photo: existsSync(join(process.cwd(), 'public', photo)) ? photo : undefined,
    pixel: pixels[String(n)],
    n,
  });
}
---

{
  items.length > 0 && (
    <section aria-labelledby="testimonials-title" data-people>
      <h2 id="testimonials-title" class="section-title">
        <Burst />
        {t(lang, 'section.testimonials')}
      </h2>
      <ul class="people">
        {items.map((it, i) => (
          <li>
            <button
              type="button"
              class="person"
              data-quote={it.quote}
              data-name={it.name}
              data-role={[it.title, it.company].filter(Boolean).join(' · ')}
              data-photo={it.photo}
              data-steps={it.photo && it.pixel ? STEPS.map((k) => stepSrc(it.n, k)).join(' ') : undefined}
              aria-describedby={`quote-${i}`}
              aria-expanded="false"
              aria-controls="people-quote"
            >
              <span class="photo" data-step={it.pixel ? '0' : '4'}>
                {it.pixel && (
                  <svg class="px-art" viewBox={`0 0 ${pixelPeople.size} ${pixelPeople.size}`} shape-rendering="crispEdges" aria-hidden="true">
                    <path d={it.pixel} />
                  </svg>
                )}
                {it.photo && it.pixel && STEPS.map((k, s) => <img class={`s${s + 1}`} src={stepSrc(it.n, k)} alt="" loading="lazy" />)}
                {it.photo && <img class="s4" src={it.photo} alt="" loading="lazy" />}
              </span>
              <span class="name">{it.name}</span>
              <span class="role">{it.title}</span>
              <span class="role">{it.company}</span>
            </button>
            {/* Screen readers get the quote right with the person */}
            <span class="sr-only" id={`quote-${i}`}>
              {it.quote}
            </span>
          </li>
        ))}
      </ul>
      {/* Phones: a half sheet with the chosen person's words */}
      <dialog class="tsheet" aria-labelledby="tsheet-name">
        <div class="scrim" data-close />
        {/* Focus lands on the sheet itself, not the close button, so no ring flashes on open */}
        <div class="panel" tabindex="-1" autofocus>
          <div class="drag">
            <div class="grab" aria-hidden="true"><span /></div>
            <div class="who">
              <span class="photo" data-step="4">
                <svg class="px-art" viewBox={`0 0 ${pixelPeople.size} ${pixelPeople.size}`} shape-rendering="crispEdges" aria-hidden="true"><path /></svg>
                <img class="s1" alt="" /><img class="s2" alt="" /><img class="s3" alt="" /><img class="s4" alt="" />
              </span>
              <span>
                <span class="name" id="tsheet-name" />
                <span class="role" />
              </span>
            </div>
            <button type="button" class="close" aria-label={closeLabel} data-close>
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            </button>
          </div>
          <p class="quote" />
        </div>
      </dialog>
      {/* Wider screens: the chosen person's words open below the row */}
      <div class="expand" id="people-quote">
        <div class="expand-inner">
          <div class="bubble">
            <span class="notch" aria-hidden="true" />
            <p class="bubble-quote" aria-live="polite" />
            <button type="button" class="bubble-close" aria-label={closeLabel}>
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            </button>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  /* A sideways row: four and a half people show, the half hints there's more */
  .people {
    --gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .people::-webkit-scrollbar {
    display: none;
  }
  .people li {
    /* Keeps each hidden screen reader quote inside the row, so it can't widen the page */
    position: relative;
    flex: 0 0 calc((100% - 4 * var(--gap)) / 4.5);
    margin: 0;
    scroll-snap-align: start;
  }
  /* Dragging with a mouse */
  .people.dragging {
    scroll-snap-type: none;
    cursor: grabbing;
  }
  .people.dragging .person {
    pointer-events: none;
  }
  .person {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    padding: 16px 6px;
    border: 0;
    border-radius: 14px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: center;
    cursor: default;
    transition: background-color var(--duration) var(--ease-out);
  }
  .photo {
    position: relative;
    display: block;
    width: 72px;
    height: 72px;
    margin-bottom: 12px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-surface);
    color: var(--color-text);
    transition: scale var(--duration) var(--ease-out);
  }
  /* Layers: the pixel portrait, three coarse-to-fine steps, then the photo. data-step picks one. */
  .photo > * {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  .photo img {
    object-fit: cover;
  }
  .photo .s1,
  .photo .s2,
  .photo .s3 {
    image-rendering: pixelated;
  }
  .px-art path {
    fill: currentColor;
  }
  /* The pixel portrait is always dark ink on a light disc, in dark mode too, so hair stays black */
  .photo[data-step='0'] {
    background: #eeeeea;
    color: #1a1a1a;
  }
  .photo[data-step='0'] .px-art,
  .photo[data-step='1'] .s1,
  .photo[data-step='2'] .s2,
  .photo[data-step='3'] .s3,
  .photo[data-step='4'] .s4 {
    opacity: 1;
  }
  .name {
    font-weight: 500;
    line-height: 1.35;
  }
  .role {
    margin-top: 2px;
    font-size: var(--text-sm);
    line-height: 1.35;
    color: var(--color-text-muted);
  }
  .tsheet {
    display: none;
  }

  /* Wider screens: the words open below the row, a notch points at who said them */
  .expand {
    height: 0;
    overflow: hidden;
    transition: height 300ms var(--ease-out);
  }
  .expand-inner {
    /* Room for the notch above the bubble */
    padding-top: 12px;
  }
  .bubble {
    position: relative;
    /* Extra room on the right for the close button */
    padding: 20px 56px 20px 24px;
    border-radius: 14px;
    background: var(--color-surface);
  }
  .notch {
    position: absolute;
    top: -7px;
    left: 0;
    width: 16px;
    height: 16px;
    border-radius: 3px 0 0 0;
    background: var(--color-surface);
    translate: calc(var(--x, 0px) - 8px) 0;
    rotate: 45deg;
    transition:
      translate 300ms var(--ease-out),
      opacity 150ms ease;
  }
  .notch.off {
    opacity: 0;
  }
  /* Close, top right of the open quote */
  .bubble-close {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      background-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out);
  }
  .bubble-close:hover,
  .bubble-close:focus-visible {
    background: var(--color-bg);
    color: var(--color-text);
  }
  .bubble-quote {
    max-width: 68ch;
    margin: 0;
    color: var(--color-text-body);
    transition: opacity 150ms ease;
  }
  .bubble-quote.swap {
    opacity: 0;
  }
  .person {
    cursor: pointer;
  }
  .person.on {
    background: var(--color-surface);
  }

  /* Pointing at someone hints they can be clicked */
  @media (hover: hover) and (pointer: fine) {
    .person:hover,
    .person:focus-visible {
      background: color-mix(in srgb, var(--color-surface) 60%, transparent);
    }
    .person.on:hover {
      background: var(--color-surface);
    }
    .person:hover .photo {
      scale: 1.04;
    }
  }

  /* Phones: a sideways row, tap to read in a half sheet */
  @media (max-width: 600px) {
    .people {
      --gap: 4px;
    }
    .people li {
      flex-basis: 112px;
      display: flex;
    }
    /* Half sheet: same look as the case study sheet on phones */
    .tsheet[open] {
      display: block;
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
      color: inherit;
      /* clip, not hidden: focusing inside must never scroll the sheet into place before it slides */
      overflow: clip;
    }
    .tsheet::backdrop {
      background: transparent;
    }
    .scrim {
      position: absolute;
      inset: 0;
      background: rgb(0 0 0 / 0.32);
      opacity: 0;
      /* Closing is quicker than opening, like iOS sheets */
      transition: opacity 220ms ease;
    }
    .panel {
      --sheet-bg: var(--color-bg);
      position: absolute;
      inset: auto 0 0;
      display: flex;
      flex-direction: column;
      max-height: 60dvh;
      border-radius: 24px 24px 0 0;
      background: var(--sheet-bg);
      box-shadow: 0 -6px 28px rgb(0 0 0 / 0.18);
      outline: none;
      transform: translateY(100%);
      /* Closing: picks up speed as it leaves */
      transition: transform 240ms cubic-bezier(0.4, 0, 1, 1);
    }
    :global(:root[data-theme='dark']) .scrim {
      background: rgb(0 0 0 / 0.55);
    }
    :global(:root[data-theme='dark']) .panel {
      --sheet-bg: #1a1a19;
      box-shadow: 0 -6px 28px rgb(0 0 0 / 0.6), inset 1px 1px 0 0 rgb(255 255 255 / 0.06);
    }
    /* Opening: the iOS sheet curve, fast out and a long soft settle */
    .tsheet.in .scrim {
      opacity: 1;
      transition: opacity 360ms ease;
    }
    .tsheet.in .panel {
      transform: none;
      transition: transform 480ms cubic-bezier(0.32, 0.72, 0, 1);
    }
    /* The words follow the sheet up a moment later */
    .who,
    .quote {
      opacity: 0;
      translate: 0 10px;
      transition:
        opacity 160ms ease,
        translate 160ms ease;
    }
    .tsheet.in .who,
    .tsheet.in .quote {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 320ms ease 80ms,
        translate 480ms cubic-bezier(0.32, 0.72, 0, 1) 80ms;
    }
    .tsheet.in .quote {
      transition-delay: 130ms;
    }
    /* Tapping a person gives a small press */
    .person {
      transition:
        background-color var(--duration) var(--ease-out),
        scale 160ms var(--ease-out);
    }
    .person:active {
      scale: 0.96;
    }
    /* The top part is the drag area: pull down to close */
    .drag {
      position: relative;
      flex: none;
      padding: 28px 56px 0 20px;
      touch-action: none;
    }
    .grab {
      position: absolute;
      inset: 0 0 auto;
      display: flex;
      justify-content: center;
      padding-top: 8px;
    }
    .grab span {
      width: 36px;
      height: 4px;
      border-radius: 2px;
      background: var(--color-line-strong);
    }
    .who {
      display: flex;
      align-items: center;
      gap: 12px;
      text-align: left;
    }
    .who .photo {
      flex: none;
      width: 48px;
      height: 48px;
      margin: 0;
    }
    .who .name,
    .who .role {
      display: block;
    }
    .close {
      position: absolute;
      top: 20px;
      right: 16px;
      display: grid;
      place-items: center;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--color-surface);
      color: var(--color-text-muted);
      cursor: pointer;
    }
    .quote {
      margin: 0;
      padding: 16px 20px calc(24px + env(safe-area-inset-bottom));
      overflow-y: auto;
      overscroll-behavior: contain;
      color: var(--color-text-body);
      line-height: var(--leading, 1.6);
    }
    :global(html.sheet-open) {
      overflow: hidden;
    }
    .expand {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo img,
    .expand,
    .notch,
    .bubble-quote,
    .scrim,
    .panel,
    .tsheet .who,
    .tsheet .quote {
      transition: none !important;
    }
    .who,
    .quote {
      translate: none;
    }
    .person:active {
      scale: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-people]').forEach((section) => {
    const people = [...section.querySelectorAll<HTMLButtonElement>('.person')];
    const canHover = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const row = section.querySelector<HTMLElement>('.people')!;

    // Tap (phones): open a half sheet with this person's words
    const sheet = section.querySelector<HTMLDialogElement>('.tsheet')!;
    const panel = sheet.querySelector<HTMLElement>('.panel')!;
    const drag = sheet.querySelector<HTMLElement>('.drag')!;
    const sheetPhoto = sheet.querySelector<HTMLElement>('.photo')!;

    // Pixel portrait -> coarse -> finer -> photo, one step every 90ms. Back to pixels at once.
    const timers = new WeakMap<HTMLElement, number[]>();
    const reveal = (el: HTMLElement, on: boolean, delay = 0) => {
      (timers.get(el) ?? []).forEach(clearTimeout);
      timers.set(el, []);
      if (!el.querySelector('.px-art path[d]')) return; // no pixel portrait: always the photo
      if (!on) {
        el.dataset.step = '0';
        return;
      }
      if (el.dataset.step === '4') return;
      if (reduce) {
        el.dataset.step = '4';
        return;
      }
      el.dataset.step = '0';
      timers.set(
        el,
        [1, 2, 3, 4].map((s) => window.setTimeout(() => (el.dataset.step = String(s)), delay + (s - 1) * 90)),
      );
    };
    const photoOf = (p: HTMLElement) => p.querySelector<HTMLElement>('.photo')!;
    const phone = matchMedia('(max-width: 600px)');
    let closing = false;
    const open = (p: HTMLElement) => {
      // The chosen person in the row behind the sheet turns into their photo too
      people.forEach((o) => {
        o.classList.toggle('on', o === p);
        reveal(photoOf(o), o === p, 260);
      });
      sheet.querySelector('.name')!.textContent = p.dataset.name ?? '';
      sheet.querySelector('.role')!.textContent = p.dataset.role ?? '';
      sheet.querySelector('.quote')!.textContent = p.dataset.quote ?? '';
      sheet.querySelector<HTMLElement>('.quote')!.scrollTop = 0;
      // The sheet's photo: same pixel portrait and steps as the person tapped, then it sharpens
      const art = p.querySelector('.px-art path')?.getAttribute('d');
      const sheetPath = sheetPhoto.querySelector('.px-art path')!;
      if (art) sheetPath.setAttribute('d', art);
      else sheetPath.removeAttribute('d');
      const steps = (p.dataset.steps ?? '').split(' ').filter(Boolean);
      sheetPhoto.querySelectorAll<HTMLImageElement>('img').forEach((im, i) => {
        const src = i < 3 ? steps[i] : p.dataset.photo;
        if (src) im.src = src;
        else im.removeAttribute('src');
      });
      sheetPhoto.hidden = !p.dataset.photo;
      sheetPhoto.dataset.step = art && p.dataset.photo ? '0' : '4';
      closing = false;
      panel.style.transform = '';
      sheet.showModal();
      document.documentElement.classList.add('sheet-open');
      panel.getBoundingClientRect(); // start from below the screen
      sheet.classList.add('in');
      // Sharpen once the sheet has mostly slid up
      reveal(sheetPhoto, true, 260);
    };
    const close = () => {
      if (closing || !sheet.open) return;
      closing = true;
      sheet.classList.remove('in');
      panel.style.transition = '';
      panel.style.transform = '';
      const done = () => {
        if (!closing) return;
        sheet.close();
        document.documentElement.classList.remove('sheet-open');
        people.forEach((o) => {
          o.classList.remove('on');
          reveal(photoOf(o), false);
        });
        closing = false;
      };
      if (reduce) done();
      else setTimeout(done, 260);
    };
    people.forEach((p) =>
      p.addEventListener('click', () => {
        if (phone.matches) open(p);
        else toggle(p);
      }),
    );
    sheet.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
    sheet.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });

    // Pull the top part down to close; a short fast flick works too
    let startY = 0, dy = 0, lastY = 0, lastT = 0, speed = 0;
    const onMove = (e: PointerEvent) => {
      dy = Math.max(0, e.clientY - startY);
      const now = performance.now();
      speed = (e.clientY - lastY) / Math.max(1, now - lastT);
      lastY = e.clientY;
      lastT = now;
      panel.style.transform = `translateY(${dy}px)`;
    };
    const onUp = () => {
      removeEventListener('pointermove', onMove);
      removeEventListener('pointerup', onUp);
      removeEventListener('pointercancel', onUp);
      panel.style.transition = '';
      if (dy > 80 || (dy > 10 && speed > 0.5)) close();
      else panel.style.transform = '';
    };
    drag.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('.close')) return;
      startY = lastY = e.clientY;
      lastT = performance.now();
      dy = speed = 0;
      panel.style.transition = 'none';
      addEventListener('pointermove', onMove);
      addEventListener('pointerup', onUp);
      addEventListener('pointercancel', onUp);
    });
    // Wider screens: click to open their words below the row; click again or Esc to close
    const expand = section.querySelector<HTMLElement>('.expand')!;
    const inner = expand.querySelector<HTMLElement>('.expand-inner')!;
    const bubble = expand.querySelector<HTMLElement>('.bubble')!;
    const notch = expand.querySelector<HTMLElement>('.notch')!;
    const words = expand.querySelector<HTMLElement>('.bubble-quote')!;
    let current: HTMLElement | null = null;
    let swapTimer = 0;
    const select = (p: HTMLElement | null) => {
      current = p;
      people.forEach((o) => {
        o.classList.toggle('on', o === p);
        o.setAttribute('aria-expanded', String(o === p));
        reveal(photoOf(o), o === p);
      });
    };
    // Point the notch at the chosen person; hide it when they scroll out of the row
    const aimNotch = () => {
      if (!current) return;
      const c = current.getBoundingClientRect();
      const r = row.getBoundingClientRect();
      const mid = c.left + c.width / 2;
      notch.style.setProperty('--x', `${mid - bubble.getBoundingClientRect().left}px`);
      notch.classList.toggle('off', mid < r.left + 12 || mid > r.right - 12);
    };
    const fit = () => {
      expand.style.height = `${inner.offsetHeight}px`;
    };
    const toggle = (p: HTMLElement) => {
      clearTimeout(swapTimer);
      if (current === p) {
        expand.style.height = '0px';
        select(null);
        return;
      }
      const wasOpen = !!current;
      select(p);
      if (!wasOpen) {
        // Open: set the words, place the notch without sliding, then grow
        words.textContent = p.dataset.quote ?? '';
        words.classList.remove('swap');
        notch.style.transition = 'none';
        aimNotch();
        notch.getBoundingClientRect();
        notch.style.transition = '';
        fit();
        return;
      }
      // Switch: the notch slides over, the words fade out and back in, the height follows
      aimNotch();
      words.classList.add('swap');
      swapTimer = window.setTimeout(
        () => {
          words.textContent = p.dataset.quote ?? '';
          words.classList.remove('swap');
          fit();
        },
        reduce ? 0 : 150,
      );
    };
    // The close button (and Esc) closes the open quote and hands focus back to the person
    expand.querySelector('.bubble-close')!.addEventListener('click', () => {
      if (!current) return;
      const p = current;
      toggle(p);
      p.focus({ preventScroll: true });
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && current && !phone.matches) {
        const p = current;
        toggle(p);
        p.focus();
      }
    });
    row.addEventListener(
      'scroll',
      () => {
        notch.style.transition = 'none';
        aimNotch();
        requestAnimationFrame(() => (notch.style.transition = ''));
      },
      { passive: true },
    );
    addEventListener('resize', () => {
      if (!current) return;
      if (phone.matches) {
        expand.style.height = '0px';
        select(null);
        return;
      }
      aimNotch();
      fit();
    });

    if (!canHover) return;

    // Mouse users can drag the row sideways (trackpads scroll it natively)
    let downX = 0, startLeft = 0, moved = false;
    row.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      downX = e.clientX;
      startLeft = row.scrollLeft;
      moved = false;
      const move = (ev: PointerEvent) => {
        const dx = ev.clientX - downX;
        if (!moved && Math.abs(dx) < 4) return;
        if (!moved) {
          moved = true;
          row.classList.add('dragging');
        }
        row.scrollLeft = startLeft - dx;
      };
      const up = () => {
        removeEventListener('pointermove', move);
        removeEventListener('pointerup', up);
        if (!moved) return;
        // Let it snap to the nearest person again
        const left = row.scrollLeft;
        row.classList.remove('dragging');
        row.scrollLeft = left;
      };
      addEventListener('pointermove', move);
      addEventListener('pointerup', up);
    });
  });
</script>
