---
/*
  Before and after flows as rows of phone screens. When the block scrolls into view
  it shows the old flow, then the steps that were cut fold away and the new flow
  rises in. A Before | After toggle lets people switch back and forth.
  From a 🔁 callout in Notion, one line per screen, in order:
    before: id: label           (screen kept in some form)
    before: id: label | gone    (step that was cut)
    after: id: label
  Images at public/images/<case slug>/<id>.webp (portrait phone screens, 750×1624).
*/
interface Screen {
  id: string;
  label: string;
  src: string;
  gone?: boolean;
}
interface Props {
  before: Screen[];
  after: Screen[];
}
const { before, after } = Astro.props;

// Delays (ms): cut steps leave first, kept ones after, then the new flow rises in
let goneCount = 0;
let keptCount = 0;
const beforeDelays = before.map((s, i) => ({
  out: s.gone ? goneCount++ * 70 : 260 + keptCount++ * 40,
  in: 280 + i * 55,
}));
const afterDelays = after.map((_, i) => ({ in: 560 + i * 90, out: i * 40 }));
---

<figure class="flow-swap" data-flow-swap data-state="before">
  <div class="toggle" role="group" aria-label="Compare the sign-up flows">
    <button type="button" data-show="before" aria-pressed="true">
      Before <span>{before.length} steps</span>
    </button>
    <button type="button" data-show="after" aria-pressed="false">
      After <span>{after.length} steps</span>
    </button>
  </div>
  <div class="stage">
    <ol class="set before" aria-label={`Before: ${before.length} steps`}>
      {
        before.map((s, i) => (
          <li
            class:list={['phone', { gone: s.gone }]}
            style={`--in:${beforeDelays[i].in}ms;--out:${beforeDelays[i].out}ms`}
          >
            <img src={s.src} alt={s.label} loading="lazy" />
          </li>
        ))
      }
    </ol>
    <ol class="set after" aria-label={`After: ${after.length} steps`} aria-hidden="true">
      {
        after.map((s, i) => (
          <li class="phone" style={`--in:${afterDelays[i].in}ms;--out:${afterDelays[i].out}ms`}>
            <img src={s.src} alt={s.label} loading="lazy" />
          </li>
        ))
      }
    </ol>
  </div>
</figure>

<style>
  .flow-swap {
    margin: var(--space-5) 0;
  }

  /* Before | After toggle */
  .toggle {
    display: flex;
    justify-content: center;
    gap: 4px;
    width: fit-content;
    margin: 0 auto 16px;
    padding: 4px;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
  }
  .toggle button {
    appearance: none;
    border: 0;
    margin: 0;
    padding: 8px 16px;
    border-radius: 999px;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      background 200ms var(--ease-out),
      color 200ms var(--ease-out);
  }
  .toggle button span {
    margin-left: 4px;
    font-weight: 400;
    opacity: 0.75;
  }
  .toggle button[aria-pressed='true'] {
    background: var(--color-text);
    color: var(--color-bg);
  }
  .toggle button:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 2px;
  }

  /* Stage: both flows stacked in the same spot, so switching never moves the page */
  .stage {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: 0 4%;
    border-radius: var(--radius);
    overflow: hidden;
    /* Same blue-gray as the other images in this case */
    background:
      radial-gradient(120% 90% at 30% 0%, rgb(255 255 255 / 0.14), transparent 60%),
      linear-gradient(115deg, #3d475a 0%, #75839a 42%, #4a5468 70%, #262c3b 100%);
  }
  /* Beats the article's own list styles */
  figure.flow-swap .set {
    grid-area: 1 / 1;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  figure.flow-swap .before {
    gap: 1.4%;
  }
  figure.flow-swap .after {
    gap: 2.6%;
  }
  figure.flow-swap .phone {
    margin: 0;
    padding: 0;
    flex: none;
    transition:
      opacity 420ms var(--ease-out),
      transform 560ms var(--ease-out);
  }
  figure.flow-swap .before .phone {
    width: 12.2%;
  }
  figure.flow-swap .after .phone {
    width: 16.4%;
  }
  .phone img {
    display: block;
    width: 100%;
    aspect-ratio: 750 / 1624;
    object-fit: cover;
    border-radius: 11% / 5%;
    background: #fff;
    box-shadow: 0 18px 36px rgb(0 0 0 / 0.25);
  }

  /* Showing: each screen comes in on its own delay */
  [data-state='before'] .before .phone,
  [data-state='after'] .after .phone {
    opacity: 1;
    transform: none;
    transition-delay: var(--in);
  }
  /* Hiding */
  [data-state='after'] .before .phone,
  [data-state='before'] .after .phone {
    opacity: 0;
    pointer-events: none;
    transition-delay: var(--out);
  }
  [data-state='after'] .before .phone {
    transform: translateY(-10px) scale(0.94);
  }
  /* Cut steps fold away first and further */
  [data-state='after'] .before .phone.gone {
    transform: translateY(18px) scale(0.82);
  }
  [data-state='before'] .after .phone {
    transform: translateY(24px) scale(0.96);
  }

  /* Phones: wrap into two rows so screens stay readable */
  @media (max-width: 600px) {
    .stage {
      aspect-ratio: auto;
      padding: 28px 16px;
    }
    figure.flow-swap .set {
      flex-wrap: wrap;
      row-gap: 16px;
    }
    figure.flow-swap .before {
      gap: 16px 4%;
    }
    figure.flow-swap .after {
      gap: 16px 5%;
    }
    figure.flow-swap .before .phone {
      width: 21%;
    }
    figure.flow-swap .after .phone {
      width: 28%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    figure.flow-swap .phone {
      transition: none;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-flow-swap]').forEach((fig) => {
    const buttons = [...fig.querySelectorAll<HTMLButtonElement>('[data-show]')];
    const sets = {
      before: fig.querySelector<HTMLElement>('.set.before')!,
      after: fig.querySelector<HTMLElement>('.set.after')!,
    };
    let touched = false;
    let timer: number | undefined;

    const show = (state: 'before' | 'after') => {
      fig.dataset.state = state;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.show === state)));
      sets.before.setAttribute('aria-hidden', String(state !== 'before'));
      sets.after.setAttribute('aria-hidden', String(state !== 'after'));
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        touched = true;
        clearTimeout(timer);
        show(b.dataset.show as 'before' | 'after');
      }),
    );

    // Play once: show the old flow briefly, then switch to the new one
    if (reduce) return;
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        if (!touched) timer = window.setTimeout(() => !touched && show('after'), 1100);
      },
      { root: fig.closest('.scroller'), threshold: 0.5 },
    );
    io.observe(fig.querySelector('.stage')!);
  });
</script>
