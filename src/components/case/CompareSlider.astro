---
/*
  Before and after flows on top of each other, with a line people drag left and
  right to compare. Left of the line shows Before, right of it shows After.
  Same data as FlowSwap (🔁 callout in Notion), so the two can be swapped freely.
  Keyboard: the handle is a slider (arrow keys, Home, End).
*/
interface Screen {
  id: string;
  label: string;
  src: string;
  gone?: boolean;
}
interface Props {
  before: Screen[];
  after: Screen[];
}
const { before, after } = Astro.props;
---

<figure class="compare" data-compare style="--pos: 50%">
  <div class="stage">
    <div class="layer after">
      <ol class="set" aria-label={`After: ${after.length} steps`}>
        {
          after.map((s) => (
            <li class="phone">
              <img src={s.src} alt={s.label} loading="lazy" draggable="false" />
            </li>
          ))
        }
      </ol>
      <span class="tag tag-after">After <em>{after.length} steps</em></span>
    </div>
    <div class="layer before">
      <ol class="set" aria-label={`Before: ${before.length} steps`}>
        {
          before.map((s) => (
            <li class="phone">
              <img src={s.src} alt={s.label} loading="lazy" draggable="false" />
            </li>
          ))
        }
      </ol>
      <span class="tag tag-before">Before <em>{before.length} steps</em></span>
    </div>
    <div class="divider" aria-hidden="true">
      <span class="knob">
        <svg viewBox="0 0 24 24"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6"></path></svg>
      </span>
    </div>
    <input
      class="range"
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      aria-label="Drag to compare the old and new sign-up flows"
    />
  </div>
</figure>

<style>
  .compare {
    margin: var(--space-5) 0;
  }
  .stage {
    position: relative;
    display: grid;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    /* Let people still scroll the page vertically on touch screens */
    touch-action: pan-y;
  }
  /* Both flows sit in the same grid cell, so the stage takes the taller one's height */
  .layer {
    grid-area: 1 / 1;
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: 0 4%;
    background:
      radial-gradient(120% 90% at 30% 0%, rgb(255 255 255 / 0.14), transparent 60%),
      linear-gradient(115deg, #3d475a 0%, #75839a 42%, #4a5468 70%, #262c3b 100%);
  }
  /* Before covers After up to the line */
  .layer.before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  /* Beats the article's own list styles */
  figure.compare .set {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  figure.compare .before .set {
    gap: 1.4%;
  }
  figure.compare .after .set {
    gap: 2.6%;
  }
  figure.compare .phone {
    margin: 0;
    padding: 0;
    flex: none;
  }
  figure.compare .before .phone {
    width: 12.2%;
  }
  figure.compare .after .phone {
    width: 16.4%;
  }
  .phone img {
    display: block;
    width: 100%;
    aspect-ratio: 750 / 1624;
    object-fit: cover;
    border-radius: 11% / 5%;
    background: #fff;
    box-shadow: 0 18px 36px rgb(0 0 0 / 0.25);
    pointer-events: none;
  }

  /* Before / After labels in the top corners */
  .tag {
    position: absolute;
    top: 16px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.35);
    backdrop-filter: blur(6px);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
  }
  .tag em {
    margin-left: 4px;
    font-style: normal;
    font-weight: 400;
    opacity: 0.75;
  }
  .tag-before {
    left: 16px;
  }
  .tag-after {
    right: 16px;
  }

  /* The line and its handle */
  .divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 12px rgb(0 0 0 / 0.25);
    pointer-events: none;
  }
  .knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border-radius: 50%;
    background: #fff;
    color: #262c3b;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.25);
    transition: transform 160ms var(--ease-out);
  }
  .knob svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .compare.dragging .knob {
    transform: scale(1.08);
  }

  /* Native slider kept for keyboard and screen readers, drawn over the handle */
  .range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
    pointer-events: none;
  }
  .compare:has(.range:focus-visible) .knob {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* A short nudge when it first comes into view, to show it can be dragged */
  .compare.hint .layer.before,
  .compare.hint .divider {
    transition:
      clip-path 700ms var(--ease-out),
      left 700ms var(--ease-out);
  }

  @media (max-width: 600px) {
    .layer {
      aspect-ratio: auto;
      padding: 52px 16px 28px;
    }
    figure.compare .set {
      flex-wrap: wrap;
    }
    figure.compare .before .set {
      gap: 14px 4%;
    }
    figure.compare .after .set {
      gap: 14px 5%;
    }
    figure.compare .before .phone {
      width: 21%;
    }
    figure.compare .after .phone {
      width: 28%;
    }
    .tag {
      top: 12px;
    }
    .tag-before {
      left: 12px;
    }
    .tag-after {
      right: 12px;
    }
    .knob {
      width: 38px;
      height: 38px;
      margin: -19px 0 0 -19px;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-compare]').forEach((fig) => {
    const stage = fig.querySelector<HTMLElement>('.stage')!;
    const range = fig.querySelector<HTMLInputElement>('.range')!;
    let touched = false;

    const set = (pct: number) => {
      const v = Math.min(100, Math.max(0, pct));
      fig.style.setProperty('--pos', `${v}%`);
      range.value = String(Math.round(v));
      range.setAttribute('aria-valuetext', `${Math.round(v)}% Before`);
    };
    const fromPointer = (e: PointerEvent) => {
      const r = stage.getBoundingClientRect();
      set(((e.clientX - r.left) / r.width) * 100);
    };

    // Drag anywhere on the image
    stage.addEventListener('pointerdown', (e) => {
      touched = true;
      fig.classList.remove('hint');
      fig.classList.add('dragging');
      stage.setPointerCapture(e.pointerId);
      fromPointer(e);
    });
    stage.addEventListener('pointermove', (e) => {
      if (stage.hasPointerCapture(e.pointerId)) fromPointer(e);
    });
    const end = (e: PointerEvent) => {
      fig.classList.remove('dragging');
      if (stage.hasPointerCapture(e.pointerId)) stage.releasePointerCapture(e.pointerId);
    };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);

    // Keyboard
    range.addEventListener('input', () => {
      touched = true;
      fig.classList.remove('hint');
      set(Number(range.value));
    });

    // First time in view: a small left-right nudge so people know they can drag
    if (reduce) return;
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        if (touched) return;
        fig.classList.add('hint');
        const steps: [number, number][] = [
          [400, 30],
          [1200, 70],
          [2000, 50],
        ];
        steps.forEach(([t, v]) => setTimeout(() => !touched && set(v), t));
        setTimeout(() => fig.classList.remove('hint'), 2800);
      },
      { root: fig.closest('.scroller'), threshold: 0.5 },
    );
    io.observe(stage);
  });
</script>
