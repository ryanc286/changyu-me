---
/*
  Wide image slot in a case study. No caption is shown; the label becomes the
  image's alt text. Until real images are added it shows a placeholder. To add an image, put it at
  public/images/<case slug>/<id>.(jpg|png|webp) and pass src.
  A video (public/videos/<slug>/<id>.mp4, with a <id>.webp poster) plays muted on a loop,
  centered on the gray-blue gradient (or on nothing, with plain), while it is on screen.
  With progress, a thin bar under the video follows playback; it can't be dragged.
*/
interface Props {
  id: string;
  label: string;
  src?: string;
  video?: string;
  poster?: string;
  plain?: boolean; // video without the gradient behind it
  progress?: boolean; // a thin bar under the video that follows playback (display only)
}
const { id, label, src, video, poster, plain = false, progress = false } = Astro.props;

// Close-up: if public/images/<slug>/<id>-zoom.json sits next to the image, the image zooms
// into that area once it's on screen, then a sharper crop of the same area fades in.
// JSON: { "src": "/images/.../<id>-zoom.webp", "x": %, "y": %, "w": % } (area on the 16:10 image)
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
let zoom: { src: string; x: number; y: number; w: number } | undefined;
if (src && !video) {
  const file = join(process.cwd(), 'public', src.replace(/\.(webp|png|jpe?g)$/, '-zoom.json'));
  if (existsSync(file)) zoom = JSON.parse(readFileSync(file, 'utf8'));
}
---

<figure class:list={['media', { 'is-video': video, plain }]} data-id={id} data-media-video={video ? '' : undefined}>
  {
    video ? (
      <div class="video-stage">
        <video src={video} poster={poster} muted loop playsinline preload="metadata" aria-label={label} />
        {progress && (
          <span class="progress" aria-hidden="true">
            <span class="progress-fill" />
          </span>
        )}
      </div>
    ) : src && zoom ? (
      <div
        class="zoom"
        data-zoom
        style={`--ox:${((zoom.x / (100 - zoom.w)) * 100).toFixed(3)}%;--oy:${((zoom.y / (100 - zoom.w)) * 100).toFixed(3)}%;--zk:${(100 / zoom.w).toFixed(4)}`}
      >
        <img class="zoom-base" src={src} alt={label} loading="lazy" />
        <img class="zoom-close" src={zoom.src} alt="" aria-hidden="true" loading="lazy" />
      </div>
    ) : src ? (
      <img src={src} alt={label} loading="lazy" />
    ) : (
      <div class="placeholder" role="img" aria-label={`Image placeholder: ${label}`}>
        <span>{id}</span>
      </div>
    )
  }
</figure>

<style>
  .media {
    margin: var(--space-5) 0;
  }
  .placeholder {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  /* Video: kept whole, centered on the gradient */
  .video-stage {
    --inset: 7%;
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    background:
      radial-gradient(120% 90% at 30% 0%, rgb(255 255 255 / 0.14), transparent 60%),
      linear-gradient(115deg, #3d475a 0%, #75839a 42%, #4a5468 70%, #262c3b 100%);
  }
  /* Centered and kept whole, whatever its shape */
  video {
    position: absolute;
    inset: 0;
    margin: auto;
    display: block;
    max-width: calc(100% - 2 * var(--inset));
    max-height: calc(100% - 2 * var(--inset) * 1.6);
    border-radius: 10px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 24px 48px rgb(0 0 0 / 0.3);
  }
  /* Plain: no gradient; the video fills the whole box, cropping the edges if needed */
  .plain .video-stage {
    background: none;
  }
  .plain video {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: none;
  }
  /* Playback bar, placed right under the video by the script */
  .progress {
    position: absolute;
    height: 3px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.25);
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
  }
  .progress.ready {
    opacity: 1;
  }
  .progress-fill {
    display: block;
    width: 100%;
    height: 100%;
    background: #fff;
    transform-origin: left;
    transform: scaleX(0);
  }
  .plain .progress {
    background: var(--color-line);
  }
  .plain .progress-fill {
    background: var(--color-text);
  }
  /* Close-up: the full picture first, then a slow push into the area that matters */
  .zoom {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .zoom img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
  }
  /* One steady push: a plain scale around the point that stays put, so the picture
     only grows and drifts toward that point, never back and forth */
  .zoom-base {
    transform-origin: var(--ox) var(--oy);
    transition: transform 1400ms cubic-bezier(0.65, 0, 0.35, 1) 600ms;
  }
  .zoom-close {
    opacity: 0;
    transition: opacity 300ms linear 1900ms;
  }
  .zoom.in .zoom-base {
    transform: scale(var(--zk));
  }
  .zoom.in .zoom-close {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .zoom-base,
    .zoom-close {
      transition: none;
    }
  }
  @media (max-width: 600px) {
    .video-stage {
      --inset: 6%;
    }
    video {
      border-radius: 6px;
    }
  }
  img {
    width: 100%;
    /* Covers are 16:10; reserve the space before the image loads */
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius);
  }
</style>

<script>
  // Close-ups zoom in once, the first time they're mostly on screen
  document.querySelectorAll<HTMLElement>('[data-zoom]').forEach((box) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      box.classList.add('in');
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        box.classList.add('in');
      },
      { root: box.closest('.scroller'), threshold: 0.6 },
    );
    io.observe(box);
  });

  // Play while on screen, pause when scrolled away. With reduced motion, show controls instead.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-media-video]').forEach((fig) => {
    const v = fig.querySelector('video');
    if (!v) return;
    if (reduce) {
      v.controls = true;
      return;
    }
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause())),
      { root: fig.closest('.scroller'), threshold: 0.3 },
    );
    io.observe(v);

    // Progress bar: sits just under the video and fills as it plays
    const bar = fig.querySelector<HTMLElement>('.progress');
    const fill = fig.querySelector<HTMLElement>('.progress-fill');
    if (!bar || !fill) return;
    const place = () => {
      if (!v.offsetWidth) return;
      bar.style.left = `${v.offsetLeft}px`;
      bar.style.width = `${v.offsetWidth}px`;
      bar.style.top = `${v.offsetTop + v.offsetHeight + 12}px`;
      bar.classList.add('ready');
    };
    let raf = 0;
    const tick = () => {
      if (v.duration) fill.style.transform = `scaleX(${v.currentTime / v.duration})`;
      raf = v.paused ? 0 : requestAnimationFrame(tick);
    };
    v.addEventListener('loadedmetadata', place);
    v.addEventListener('play', () => {
      place();
      if (!raf) raf = requestAnimationFrame(tick);
    });
    v.addEventListener('seeked', tick);
    window.addEventListener('resize', place);
    if (v.readyState >= 1) place();
  });
</script>
