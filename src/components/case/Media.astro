---
/*
  Wide image slot in a case study. No caption is shown; the label becomes the
  image's alt text. Until real images are added it shows a placeholder. To add an image, put it at
  public/images/<case slug>/<id>.(jpg|png|webp) and pass src.
  A video (public/videos/<slug>/<id>.mp4, with a <id>.webp poster) plays muted on a loop,
  centered on the gray-blue gradient, while it is on screen.
*/
interface Props {
  id: string;
  label: string;
  src?: string;
  video?: string;
  poster?: string;
}
const { id, label, src, video, poster } = Astro.props;
---

<figure class:list={['media', { 'is-video': video }]} data-id={id} data-media-video={video ? '' : undefined}>
  {
    video ? (
      <div class="video-stage">
        <video src={video} poster={poster} muted loop playsinline preload="metadata" aria-label={label} />
      </div>
    ) : src ? (
      <img src={src} alt={label} loading="lazy" />
    ) : (
      <div class="placeholder" role="img" aria-label={`Image placeholder: ${label}`}>
        <span>{id}</span>
      </div>
    )
  }
</figure>

<style>
  .media {
    margin: var(--space-5) 0;
  }
  .placeholder {
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  /* Video: kept whole, centered on the gradient */
  .video-stage {
    --inset: 7%;
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    background:
      radial-gradient(120% 90% at 30% 0%, rgb(255 255 255 / 0.14), transparent 60%),
      linear-gradient(115deg, #3d475a 0%, #75839a 42%, #4a5468 70%, #262c3b 100%);
  }
  /* Centered and kept whole, whatever its shape */
  video {
    position: absolute;
    inset: 0;
    margin: auto;
    display: block;
    max-width: calc(100% - 2 * var(--inset));
    max-height: calc(100% - 2 * var(--inset) * 1.6);
    border-radius: 10px;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 24px 48px rgb(0 0 0 / 0.3);
  }
  @media (max-width: 600px) {
    .video-stage {
      --inset: 6%;
    }
    video {
      border-radius: 6px;
    }
  }
  img {
    width: 100%;
    /* Covers are 16:10; reserve the space before the image loads */
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius);
  }
</style>

<script>
  // Play while on screen, pause when scrolled away. With reduced motion, show controls instead.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-media-video]').forEach((fig) => {
    const v = fig.querySelector('video');
    if (!v) return;
    if (reduce) {
      v.controls = true;
      return;
    }
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause())),
      { root: fig.closest('.scroller'), threshold: 0.3 },
    );
    io.observe(v);
  });
</script>
