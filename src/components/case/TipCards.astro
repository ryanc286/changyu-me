---
/*
  Short tips as small cards in a 2-column grid, each with a line icon, a title and one line.
  From a 💡 callout in Notion, one "icon: Title | Text" line per tip.
  Icons: plan, image, code, ask, check, layers (falls back to a dot).
*/
interface Tip {
  icon?: string;
  title: string;
  text?: string;
}
interface Props {
  items: Tip[];
}
const { items } = Astro.props;

// 24×24 line icons, drawn with the text color
const ICONS: Record<string, string> = {
  plan: 'M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M5.6 18.4l2.1-2.1M16.3 7.7l2.1-2.1',
  image: 'M4 5h16v14H4zM4 16l5-5 4 4 2.5-2.5L20 17M15.5 9.5h.01',
  code: 'M4 4h16v16H4zM9 9l3 3-3 3',
  ask: 'M5 5h14v11H10l-4 3v-3H5zM9 10.5h.01M12 10.5h.01M15 10.5h.01',
  check: 'M5 12.5l4.5 4.5L19 7.5',
  layers: 'M12 4l8 4-8 4-8-4zM4 12l8 4 8-4M4 16l8 4 8-4',
};
const DOT = 'M12 11.99h.01';
---

<ul class="tip-cards">
  {
    items.map((it) => (
      <li>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={ICONS[it.icon ?? ''] ?? DOT} />
        </svg>
        <strong>{it.title}</strong>
        {it.text && <span>{it.text}</span>}
      </li>
    ))
  }
</ul>

<style>
  /* Beats the article's own list styles */
  ul.tip-cards {
    list-style: none;
    margin: var(--space-4) 0 var(--space-5);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  ul.tip-cards > li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 20px 22px;
    border: 1px solid var(--color-line);
    border-radius: 14px;
    background: var(--color-surface);
  }
  svg {
    width: 20px;
    height: 20px;
    margin-bottom: 8px;
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  strong {
    color: var(--color-text);
    font-weight: 600;
    line-height: 1.35;
  }
  span {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  @media (max-width: 600px) {
    ul.tip-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
