---
/*
  Design details in one fixed frame. The frame (gradient background) sticks in
  the middle of the window and keeps its size; as you scroll, each detail's phone and
  text slide up into it and the previous one slides out. Sides alternate.
  From a 📱 callout in Notion with one "id: label" line per screen
  (image at public/images/<case slug>/<id>.webp, phone frame included).
  A bullet list right before it, one "- **Title.** Text" bullet per screen,
  becomes the title and text beside each screen.
  On phones, and with reduced motion, it is a plain list on the same background.
*/
interface Item {
  id: string;
  label: string;
  src?: string;
  title?: string;
  text?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<div class="detail-list" data-detail-list style={`--n:${items.length}`}>
  <div class="frame">
    <ul class="track">
      {
        items.map((it, i) => (
          <li class:list={['detail', { flip: i % 2 === 1 }]}>
            <div class="copy">
              <p>
                {it.title && <strong>{it.title.replace(/\.?$/, '.')}</strong>} {it.text}
              </p>
            </div>
            <div class="shot">{it.src && <img src={it.src} alt={it.label} loading="lazy" />}</div>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .detail-list {
    --h: clamp(420px, 64vh, 600px);
    /* Scroll room: one frame height per detail */
    height: calc(var(--h) * var(--n));
    margin: var(--space-5) 0;
  }
  /* The frame stays put and keeps its size; only what's inside moves */
  .frame {
    position: sticky;
    /* Set by the script so the frame sits in the middle of the window */
    top: var(--stick, 32px);
    height: var(--h);
    border-radius: var(--radius);
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 30% 0%, rgb(255 255 255 / 0.14), transparent 60%),
      linear-gradient(115deg, #3d475a 0%, #75839a 42%, #4a5468 70%, #262c3b 100%);
  }
  /* Beats the article's own list styles */
  .detail-list ul.track {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    height: 100%;
  }
  .detail-list ul.track > li.detail {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0 6%;
    display: grid;
    /* Text and phone sit together in the middle */
    grid-template-columns: minmax(0, 320px) auto;
    justify-content: center;
    align-items: center;
    gap: 56px;
    /* Set by the script: 0 = in place, 1 = next (below), -1 = previous (above).
       Content moves part of the way and crossfades, rather than a full slide. */
    transform: translateY(calc(var(--y, 0) * 40%));
    will-change: transform;
  }
  .detail-list ul.track > li.detail.flip {
    grid-template-columns: auto minmax(0, 320px);
  }
  li.detail.flip .shot {
    order: -1;
  }
  .shot {
    align-self: stretch;
    min-height: 0;
    display: flex;
    align-items: center;
  }
  .shot img {
    display: block;
    height: 84%;
    width: auto;
    filter: drop-shadow(0 24px 40px rgb(0 0 0 / 0.3));
  }

  /* Fixed colors: the background is always the dark gradient, whatever the site theme */
  .detail-list .copy p {
    margin: 0;
    color: rgb(255 255 255 / 0.75);
  }
  .detail-list .copy strong {
    color: #fff;
    font-weight: 600;
  }

  /* Phones and reduced motion: a plain list on the same background */
  @media (max-width: 600px), (prefers-reduced-motion: reduce) {
    .detail-list {
      height: auto;
    }
    .frame {
      position: static;
      height: auto;
    }
    .detail-list ul.track {
      height: auto;
    }
    .detail-list ul.track > li.detail {
      position: static;
      transform: none;
      height: var(--h);
    }
  }
  @media (max-width: 600px) {
    .detail-list ul.track > li.detail,
    .detail-list ul.track > li.detail.flip {
      height: auto;
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 28px 20px 0;
    }
    li.detail.flip .shot {
      order: 0;
    }
    .shot {
      align-self: auto;
      justify-content: center;
      /* Show the top part of the phone; the next row covers the rest */
      max-height: 340px;
      overflow: hidden;
      align-items: flex-start;
    }
    .shot img {
      height: auto;
      width: 62%;
    }
  }
</style>

<script>
  const still = matchMedia('(max-width: 600px), (prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-detail-list]').forEach((box) => {
    const frame = box.querySelector<HTMLElement>('.frame')!;
    const items = [...box.querySelectorAll<HTMLElement>('li.detail')];
    const scroller = box.closest<HTMLElement>('.scroller');
    const n = items.length;
    let raf = 0;

    // Each detail rests for a moment, then eases to the next over most of the scroll
    const ease = (f: number) => {
      const t = Math.min(1, Math.max(0, (f - 0.15) / 0.7));
      return t * t * (3 - 2 * t);
    };
    // Stick the frame in the middle of the visible area
    let stick = 32;
    const measure = () => {
      const viewH = scroller ? scroller.clientHeight : window.innerHeight;
      stick = Math.max(16, Math.round((viewH - frame.offsetHeight) / 2));
      box.style.setProperty('--stick', `${stick}px`);
    };
    const target = () => {
      const run = box.offsetHeight - frame.offsetHeight;
      const viewTop = scroller ? scroller.getBoundingClientRect().top : 0;
      const top = box.getBoundingClientRect().top - viewTop - stick;
      const progress = Math.min(1, Math.max(0, -top / run)) * (n - 1);
      const step = Math.max(0, Math.min(n - 2, Math.floor(progress)));
      return step + ease(progress - step);
    };
    const paint = (p: number) => {
      items.forEach((li, i) => {
        const y = i - p;
        li.style.setProperty('--y', y.toFixed(4));
        // Leaving content fades out as the next fades in, so the swap feels soft
        li.style.opacity = String(Math.max(0, 1 - Math.abs(y) * 1.8));
      });
    };

    // Follow the scroll with a little lag instead of jumping with each wheel step
    let cur = target();
    const update = () => {
      raf = 0;
      if (still.matches) {
        items.forEach((li) => {
          li.style.removeProperty('--y');
          li.style.removeProperty('opacity');
        });
        return;
      }
      const goal = target();
      cur += (goal - cur) * 0.14;
      if (Math.abs(goal - cur) < 0.001) cur = goal;
      paint(cur);
      if (cur !== goal) raf = requestAnimationFrame(update);
    };
    const queue = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };

    (scroller ?? window).addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', () => {
      measure();
      queue();
    });
    still.addEventListener('change', queue);
    measure();
    cur = target();
    queue();
  });
</script>
