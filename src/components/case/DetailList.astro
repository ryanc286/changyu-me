---
/*
  Design details as stacked cards: each card holds a phone screen and its text,
  sides alternating. As you scroll, each card sticks to the top and the next one
  slides up over it, so the details replace each other one by one.
  From a 📱 callout in Notion with one "id: label" line per screen
  (image at public/images/<case slug>/<id>.webp, phone frame included).
  A bullet list right before it, one "- **Title.** Text" bullet per screen,
  becomes the title and text beside each screen.
*/
interface Item {
  id: string;
  label: string;
  src?: string;
  title?: string;
  text?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
---

<ul class="detail-list">
  {
    items.map((it, i) => (
      <li class:list={['detail', { flip: i % 2 === 1 }]} style={`--i:${i}`}>
        <div class="copy">
          <p>
            {it.title && <strong>{it.title.replace(/\.?$/, '.')}</strong>} {it.text}
          </p>
        </div>
        <div class="shot">{it.src && <img src={it.src} alt={it.label} loading="lazy" />}</div>
      </li>
    ))
  }
</ul>

<style>
  /* Beats the article's own list styles */
  ul.detail-list {
    list-style: none;
    margin: var(--space-5) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  /* Each card sticks near the top of the page; the next one scrolls up over it */
  ul.detail-list > li.detail {
    position: sticky;
    top: 32px;
    margin: 0;
    padding: 0 7%;
    height: clamp(420px, 64vh, 600px);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 6%;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: 0 -1px 0 var(--color-line);
    overflow: hidden;
  }
  /* Every other card: phone on the left, text on the right */
  ul.detail-list > li.detail.flip {
    grid-template-columns: auto 1fr;
  }
  li.detail.flip .shot {
    order: -1;
  }
  .shot {
    align-self: stretch;
    min-height: 0;
    display: flex;
    align-items: center;
  }
  .shot img {
    display: block;
    height: 84%;
    width: auto;
    filter: drop-shadow(0 16px 28px rgb(0 0 0 / 0.16));
  }
  .copy {
    max-width: 360px;
  }
  li.detail.flip .copy {
    justify-self: end;
  }
  .detail-list .copy p {
    margin: 0;
  }
  .detail-list .copy strong {
    color: var(--color-text);
    font-weight: 600;
  }

  /* Phones: plain list, text above a smaller phone, no stacking */
  @media (max-width: 600px) {
    ul.detail-list {
      gap: 16px;
    }
    ul.detail-list > li.detail,
    ul.detail-list > li.detail.flip {
      position: static;
      height: auto;
      grid-template-columns: 1fr;
      gap: 20px;
      padding: 28px 20px 0;
    }
    li.detail.flip .shot {
      order: 0;
    }
    li.detail.flip .copy {
      justify-self: start;
    }
    .copy {
      max-width: none;
    }
    .shot {
      align-self: auto;
      justify-content: center;
      /* Show the top part of the phone; the card edge crops the rest */
      max-height: 340px;
      align-items: flex-start;
    }
    .shot img {
      height: auto;
      width: 62%;
    }
  }
</style>
