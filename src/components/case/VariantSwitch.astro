---
/*
  A few versions of the same screen. Pick one from the list and the phone
  switches to it.
  From a 🔘 callout in Notion with one line per version:
    id: Title | Short text | Tag
  Tag (like "Dropped") is optional.
  Images at public/images/<case slug>/<id>.webp, phone frame included.
  Cycles through once when first seen; any click stops that.
  When a version has a known spot (SPOTS below), a hand-drawn loop circles
  what changed on its screen, drawn again each time it is picked.
*/
interface Item {
  id: string;
  title: string;
  text?: string;
  src: string;
  tag?: string;
}
interface Props {
  items: Item[];
}
const { items } = Astro.props;
const uid = `vs-${items.map((it) => it.id).join('-')}`;
import { caseText } from '../../i18n/case';
const L = caseText(Astro.url);

// Where each version differs, in image pixels (images are 760 × 1535): x, y, width, height
const IMG_W = 760;
const IMG_H = 1535;
const SPOTS: Record<string, [number, number, number, number]> = {
  'concept-banner': [70, 430, 614, 214],
  'concept-button': [72, 318, 158, 120],
  'concept-floating': [246, 1200, 270, 112],
};

// Same pen as the homepage headline loop: a bit more than one turn, uneven, squarer than an ellipse
function loopPath(w: number, h: number) {
  const pts: [number, number][] = [];
  const wob = [0.02, -0.04, 0.03, 0.05, -0.02, 0.04, -0.03, 0.02, 0.05, -0.02, 0.03, -0.04, 0.02, 0.04, 0.01, -0.03, 0.03, 0.05, 0.07];
  const steps = 18;
  const sq = (v: number) => Math.sign(v) * Math.abs(v) ** 0.7;
  for (let i = 0; i <= steps; i++) {
    const a = Math.PI * 1.2 + (i / steps) * 1.18 * Math.PI * 2;
    const r = (1 + wob[i]) * (1 + (i / steps) * 0.05);
    pts.push([w / 2 + sq(Math.cos(a)) * (w / 2) * r, h / 2 + sq(Math.sin(a)) * (h / 2) * r]);
  }
  const f = (n: number) => n.toFixed(1);
  let d = `M${f(pts[0][0])} ${f(pts[0][1])}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const [p1, p2] = [pts[i], pts[i + 1]];
    const p3 = pts[i + 2] ?? p2;
    d += ` C${f(p1[0] + (p2[0] - p0[0]) / 6)} ${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)} ${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])} ${f(p2[1])}`;
  }
  return d;
}
const loops = items.map((it) => {
  const s = SPOTS[it.id];
  if (!s) return null;
  const [x, y, w, h] = s;
  return {
    d: loopPath(w, h),
    w,
    h,
    style: `left:${(x / IMG_W) * 100}%;top:${(y / IMG_H) * 100}%;width:${(w / IMG_W) * 100}%;height:${(h / IMG_H) * 100}%`,
  };
});
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<figure class="variant-switch" data-variant-switch>
  <div class="stage">
    <div class="list" role="tablist" aria-label={L.versions}>
      {
        items.map((it, i) => (
          <button
            type="button"
            role="tab"
            id={`${uid}-tab-${i}`}
            aria-controls={`${uid}-panel`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="option"
          >
            <span class="num" aria-hidden="true">{pad(i)}</span>
            <span class="name">
              {it.title}
              {it.tag && <em class="tag">{it.tag}</em>}
            </span>
            {it.text && (
              <span class="more">
                <span class="text">{it.text}</span>
              </span>
            )}
          </button>
        ))
      }
    </div>
    <div class="phone" id={`${uid}-panel`} role="tabpanel" aria-live="polite">
      {
        items.map((it, i) => (
          <div class:list={['screen', { on: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
            <img src={it.src} alt={it.title} loading="lazy" draggable="false" />
            {loops[i] && (
              <svg class="loop" style={loops[i].style} viewBox={`0 0 ${loops[i].w} ${loops[i].h}`} aria-hidden="true">
                <path d={loops[i].d} pathLength="1" />
              </svg>
            )}
          </div>
        ))
      }
    </div>
    <p class="caption" aria-hidden="true">{items[0].text}</p>
  </div>
</figure>

<style>
  .variant-switch {
    margin: var(--space-5) 0;
  }
  .stage {
    display: grid;
    /* Phone is 92% of the 4:3 stage's height: 0.92 × 3/4 × 760/1535 ≈ 34.2% of its width */
    grid-template-columns: minmax(0, 360px) 34.2%;
    /* List and phone sit together as one group in the middle */
    justify-content: center;
    align-items: center;
    gap: 48px;
    aspect-ratio: 4 / 3;
    padding: 0 6%;
    border-radius: var(--radius);
    /* Same warm olive as the other images in this case */
    background:
      radial-gradient(110% 80% at 55% 0%, rgb(255 255 255 / 0.12), transparent 60%),
      linear-gradient(160deg, #6e604c 0%, #8c7b66 32%, #6a6553 62%, #3f463c 100%);
  }

  /* The list of versions: a thin rail on the left, the chosen one marked in white */
  .list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    border-left: 1px solid rgb(255 255 255 / 0.2);
  }
  .option {
    position: relative;
    display: grid;
    grid-template-columns: 2.1em minmax(0, 1fr);
    column-gap: 4px;
    width: 100%;
    padding: 10px 8px 10px 16px;
    border: 0;
    background: transparent;
    color: rgb(255 255 255 / 0.7);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: color 250ms var(--ease-out);
  }
  /* The chosen marker sits on the rail */
  .option::before {
    content: '';
    position: absolute;
    left: -1.5px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    border-radius: 2px;
    background: #fff;
    scale: 1 0;
    transition: scale 300ms var(--ease-out);
  }
  .option:hover {
    color: rgb(255 255 255 / 0.9);
  }
  .option[aria-selected='true'] {
    color: #fff;
  }
  .option[aria-selected='true']::before {
    scale: 1 1;
  }
  .option:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 0;
    border-radius: 6px;
  }
  .num {
    padding-top: 0.2em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.4;
    opacity: 0.7;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.4;
  }
  /* Only the chosen version shows its text; it opens and closes smoothly */
  .more {
    grid-column: 2;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 350ms var(--ease-out),
      opacity 250ms var(--ease-out);
  }
  .option[aria-selected='true'] .more {
    grid-template-rows: 1fr;
    opacity: 1;
  }
  .text {
    min-height: 0;
    overflow: hidden;
    padding-top: 4px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.85);
  }
  .tag {
    padding: 1px 6px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.25);
    font-style: normal;
    font-weight: 500;
    font-size: 0.625rem;
    letter-spacing: 0.02em;
  }

  /* The phone: all versions stacked, the chosen one fades in */
  .phone {
    position: relative;
    display: grid;
  }
  .screen {
    grid-area: 1 / 1;
    position: relative;
    width: 100%;
    aspect-ratio: 760 / 1535;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }
  .screen.on {
    opacity: 1;
  }
  .screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 24px 40px rgb(0 0 0 / 0.3));
    user-select: none;
  }
  /* The pen loop around what changed: hidden until its screen is shown, then drawn */
  .loop {
    position: absolute;
    overflow: visible;
    pointer-events: none;
    fill: none;
    /* Warm olive ink, taken from the stage's gradient */
    stroke: #7a6a52;
    stroke-width: 2.5px;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
    rotate: -2deg;
  }
  .loop path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .screen.drawn .loop path {
    animation: loop-draw 650ms cubic-bezier(0.55, 0.1, 0.35, 1) 300ms forwards;
  }
  @keyframes loop-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  .caption {
    display: none;
  }
  @media (max-width: 600px) {
    .caption {
      display: block;
      min-height: 2.9em;
      margin: -4px 0 0;
      color: rgb(255 255 255 / 0.85);
      font-size: 0.8125rem;
      line-height: 1.45;
      text-align: center;
    }
    .stage {
      grid-template-columns: 1fr;
      aspect-ratio: auto;
      gap: 20px;
      padding: 20px 16px 28px;
    }
    /* A small segmented bar */
    .list {
      flex-direction: row;
      gap: 2px;
      max-width: none;
      padding: 3px;
      border-radius: 999px;
      background: rgb(0 0 0 / 0.2);
    }
    .list {
      border-left: 0;
    }
    .option {
      display: flex;
      flex: 1 1 auto;
      justify-content: center;
      min-width: 0;
      padding: 7px 6px;
      border-radius: 999px;
      text-align: center;
      transition:
        background 250ms var(--ease-out),
        color 250ms var(--ease-out);
    }
    .option::before,
    .num,
    .more {
      display: none;
    }
    .option[aria-selected='true'] {
      background: rgb(255 255 255 / 0.2);
    }
    .option:focus-visible {
      border-radius: 999px;
    }
    .name {
      font-size: 0.625rem;
      line-height: 1.2;
      white-space: nowrap;
    }
    .tag {
      display: none;
    }
    .phone {
      justify-items: center;
    }
    .screen {
      width: 78%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .screen,
    .option,
    .option::before,
    .more {
      transition: none;
    }
    .screen.drawn .loop path {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-variant-switch]').forEach((fig) => {
    const tabs = [...fig.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const screens = [...fig.querySelectorAll<HTMLElement>('.screen')];
    const texts = tabs.map((t) => t.querySelector('.text')?.textContent ?? '');
    const caption = fig.querySelector<HTMLElement>('.caption')!;
    let current = 0;
    let touched = false;
    let timer = 0;

    const show = (i: number, focus = false) => {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => {
        const on = k === current;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      screens.forEach((s, k) => {
        s.classList.toggle('on', k === current);
        // Restart the pen loop on the chosen screen
        s.classList.remove('drawn');
        if (k === current) {
          void s.offsetWidth;
          s.classList.add('drawn');
        }
        if (k === current) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      caption.textContent = texts[current];
      if (focus) tabs[current].focus();
    };
    const stop = () => {
      touched = true;
      clearTimeout(timer);
    };

    tabs.forEach((t, i) =>
      t.addEventListener('click', () => {
        stop();
        show(i);
      }),
    );
    fig.querySelector('[role="tablist"]')!.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      const next =
        key === 'ArrowDown' || key === 'ArrowRight'
          ? current + 1
          : key === 'ArrowUp' || key === 'ArrowLeft'
            ? current - 1
            : key === 'Home'
              ? 0
              : key === 'End'
                ? tabs.length - 1
                : null;
      if (next === null) return;
      e.preventDefault();
      stop();
      show(next, true);
    });

    // First time in view: go through each version once, then back to the first
    if (reduce) {
      show(0);
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        if (!touched) show(current);
        const step = (i: number) => {
          if (touched) return;
          show(i);
          if (i !== 0) timer = window.setTimeout(() => step((i + 1) % tabs.length), 2600);
        };
        timer = window.setTimeout(() => step(1), 2200);
      },
      { root: fig.closest('.scroller'), threshold: 0.5 },
    );
    io.observe(fig);
  });
</script>
