---
// Row of big numbers in a case study (from a Number | Label table in Notion).
// Optional Title | Text columns add a short explanation under each number (e.g. pain points).
interface Props {
  items: { value: string; label: string; title?: string; text?: string }[];
}
const { items } = Astro.props;
---

<dl class:list={['stats', { detailed: items.some((s) => s.title || s.text) }]}>
  {
    items.map((s) => (
      <div>
        <dt>{s.label}</dt>
        <dd>{s.value}</dd>
        {(s.title || s.text) && (
          <dd class="more">
            {s.title && <strong>{s.title}</strong>} {s.text}
          </dd>
        )}
      </div>
    ))
  }
</dl>

<style>
  .stats {
    margin: var(--space-4) 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-3);
  }
  .stats div {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: 2px;
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-line-strong);
  }
  dd:not(.more) {
    order: -1;
    margin: 0;
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 500;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }
  dt {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.45;
  }
  /* Detailed cards (e.g. pain points): the explanation comes first, then the number and what it means */
  .more {
    order: -2;
    margin: 0 0 var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text-body);
  }
  .more strong {
    color: var(--color-text);
    font-weight: 600;
  }
  /* Three across on desktop, stacked on phones. Rows are shared so the numbers line up even when the texts differ in length */
  .stats.detailed {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }
  @supports (grid-template-rows: subgrid) {
    .stats.detailed div {
      display: grid;
      grid-row: span 3;
      grid-template-rows: subgrid;
      row-gap: 2px;
      align-content: start;
    }
    .stats.detailed .more {
      align-self: start;
    }
  }
</style>
