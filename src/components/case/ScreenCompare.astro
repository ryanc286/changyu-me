---
/*
  One screen before and after, stacked in the same phone, with a line people drag
  left and right. Left of the line shows Before, right of it shows After.
  From a 🔁 callout in Notion with "style: slider" and exactly one before and one
  after line. Both images should be the same size, with the phone frame included
  (public/images/<case slug>/<id>.webp).
  Keyboard: the handle is a slider (arrow keys, Home, End).
*/
interface Screen {
  id: string;
  label: string;
  src: string;
}
interface Props {
  before: Screen;
  after: Screen;
}
const { before, after } = Astro.props;
---

<figure class="screen-compare" data-screen-compare style="--pos: 50%">
  <div class="stage">
    <span class="tag tag-before">Before</span>
    <span class="tag tag-after">After</span>
    <div class="device">
      <img class="shot after" src={after.src} alt={`After: ${after.label}`} loading="lazy" draggable="false" />
      <img class="shot before" src={before.src} alt={`Before: ${before.label}`} loading="lazy" draggable="false" />
      <div class="divider" aria-hidden="true">
        <span class="knob">
          <svg viewBox="0 0 24 24"><path d="M10 7l-5 5 5 5M14 7l5 5-5 5"></path></svg>
        </span>
      </div>
    </div>
    <input
      class="range"
      type="range"
      min="0"
      max="100"
      value="50"
      step="1"
      aria-label="Drag to compare the old and new screens"
    />
  </div>
</figure>

<style>
  .screen-compare {
    margin: var(--space-5) 0;
  }
  .stage {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius);
    overflow: hidden;
    cursor: ew-resize;
    user-select: none;
    -webkit-user-select: none;
    touch-action: pan-y;
    background:
      radial-gradient(120% 90% at 30% 0%, rgb(255 255 255 / 0.14), transparent 60%),
      linear-gradient(115deg, #3d475a 0%, #75839a 42%, #4a5468 70%, #262c3b 100%);
  }

  /* One phone, both screens stacked in it */
  .device {
    position: relative;
    height: 88%;
    aspect-ratio: 965 / 1948;
    filter: drop-shadow(0 24px 40px rgb(0 0 0 / 0.3));
  }
  .shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }
  .shot.before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }

  /* Before / After labels in the top corners */
  .tag {
    position: absolute;
    top: 16px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    border: 1px solid rgb(255 255 255 / 0.28);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    z-index: 1;
  }
  .tag-before {
    left: 16px;
  }
  .tag-after {
    right: 16px;
  }

  /* The line runs the height of the phone, with the same white capsule handle */
  .divider {
    position: absolute;
    top: -3%;
    bottom: -3%;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0) 0%,
      #fff 8%,
      #fff 92%,
      rgb(255 255 255 / 0) 100%
    );
    filter: drop-shadow(0 0 3px rgb(0 0 0 / 0.35));
    pointer-events: none;
  }
  .knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 52px;
    margin: -26px 0 0 -16px;
    border-radius: 999px;
    background: #fff;
    color: #262c3b;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.06),
      0 8px 24px rgb(0 0 0 / 0.28);
    transition: transform 200ms var(--ease-out);
  }
  .knob svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .stage:hover .knob {
    transform: scale(1.04);
  }
  .screen-compare.dragging .knob {
    transform: scale(1.08);
  }

  /* Native slider kept for keyboard and screen readers */
  .range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }
  .screen-compare:has(.range:focus-visible) .knob {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* A short nudge when it first comes into view */
  .screen-compare.hint .shot.before,
  .screen-compare.hint .divider {
    transition:
      clip-path 700ms var(--ease-out),
      left 700ms var(--ease-out);
  }

  @media (max-width: 600px) {
    .stage {
      aspect-ratio: auto;
      padding: 56px 0 28px;
    }
    .device {
      height: auto;
      width: 64%;
    }
    .tag {
      top: 12px;
    }
    .tag-before {
      left: 12px;
    }
    .tag-after {
      right: 12px;
    }
    .knob {
      width: 30px;
      height: 46px;
      margin: -23px 0 0 -15px;
    }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-screen-compare]').forEach((fig) => {
    const stage = fig.querySelector<HTMLElement>('.stage')!;
    const device = fig.querySelector<HTMLElement>('.device')!;
    const range = fig.querySelector<HTMLInputElement>('.range')!;
    let touched = false;

    const set = (pct: number) => {
      const v = Math.min(100, Math.max(0, pct));
      fig.style.setProperty('--pos', `${v}%`);
      range.value = String(Math.round(v));
      range.setAttribute('aria-valuetext', `${Math.round(v)}% Before`);
    };
    // Position is measured against the phone, so dragging anywhere maps onto it
    const fromPointer = (e: PointerEvent) => {
      const r = device.getBoundingClientRect();
      set(((e.clientX - r.left) / r.width) * 100);
    };

    stage.addEventListener('pointerdown', (e) => {
      touched = true;
      fig.classList.remove('hint');
      fig.classList.add('dragging');
      stage.setPointerCapture(e.pointerId);
      fromPointer(e);
    });
    stage.addEventListener('pointermove', (e) => {
      if (stage.hasPointerCapture(e.pointerId)) fromPointer(e);
    });
    const end = (e: PointerEvent) => {
      fig.classList.remove('dragging');
      if (stage.hasPointerCapture(e.pointerId)) stage.releasePointerCapture(e.pointerId);
    };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);

    range.addEventListener('input', () => {
      touched = true;
      fig.classList.remove('hint');
      set(Number(range.value));
    });

    if (reduce) return;
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        if (touched) return;
        fig.classList.add('hint');
        const steps: [number, number][] = [
          [400, 25],
          [1200, 75],
          [2000, 50],
        ];
        steps.forEach(([t, v]) => setTimeout(() => !touched && set(v), t));
        setTimeout(() => fig.classList.remove('hint'), 2800);
      },
      { root: fig.closest('.scroller'), threshold: 0.5 },
    );
    io.observe(stage);
  });
</script>
