---
/* Homepage content (no page shell). Used by Home and as the backdrop behind case studies. */
import WorkList from './WorkList.astro';
import ToolList from './ToolList.astro';
import Footer from './Footer.astro';
import Testimonials from './Testimonials.astro';
import CopyWithLinks from './CopyWithLinks.astro';
import HoverPreview from './HoverPreview.astro';
import HandTitle from './HandTitle.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<script is:inline>
  /* First homepage view in a visit: content rises into place. Set before anything paints. */
  (() => {
    const html = document.documentElement;
    if (html.dataset.page === 'case' || !('IntersectionObserver' in window)) return;
    try {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (sessionStorage.getItem('homeRevealed')) return;
      sessionStorage.setItem('homeRevealed', '1');
    } catch {
      return;
    }
    html.classList.add('reveal');
  })();
</script>

<main class="container stack">
    <section class="intro">
      <h1><HandTitle lang={lang} /></h1>
      <p><CopyWithLinks lang={lang} text={t(lang, 'home.intro')} /></p>
      <p><CopyWithLinks lang={lang} text={t(lang, 'home.previously')} /></p>
      <p><CopyWithLinks lang={lang} text={t(lang, 'home.outside')} /></p>
    </section>

    <WorkList lang={lang} />
    <ToolList lang={lang} />
    <Testimonials lang={lang} />
    <Footer lang={lang} />
    <HoverPreview lang={lang} />
  </main>

<script>
  // Reveal each block as it comes into view; blocks that arrive together rise at the same time
  if (document.documentElement.classList.contains('reveal')) {
    const blocks = document.querySelectorAll<HTMLElement>(
      'main.stack > .intro > *, main.stack > section:not(.intro), main.stack > footer',
    );
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    blocks.forEach((b) => io.observe(b));
  }
</script>

<style>
  /* Rise into place: hidden until marked in, then a soft slide up */
  :global(html.reveal main.stack > .intro > *, html.reveal main.stack > section:not(.intro), html.reveal main.stack > footer) {
    transition:
      opacity 600ms ease,
      translate 800ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(html.reveal main.stack > .intro > :not(.in), html.reveal main.stack > section:not(.intro, .in), html.reveal main.stack > footer:not(.in)) {
    opacity: 0;
    translate: 0 24px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    /* 64px between sections: each one starts clearly, still one page */
    gap: 64px;
    /* Generous top space so the intro reads as the start of the page */
    padding-top: 160px;
    padding-bottom: 80px;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  h1 {
    margin: 0 0 var(--space-1);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    line-height: 1.4;
    font-weight: 600;
  }
  p {
    margin: 0;
    color: var(--color-text-body);
  }
  @media (max-width: 520px) {
    .stack {
      gap: 48px;
      padding-top: 96px;
      padding-bottom: 48px;
    }
  }
</style>
