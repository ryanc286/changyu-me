---
/* Homepage content (no page shell). Used by Home and as the backdrop behind case studies. */
import WorkList from './WorkList.astro';
import ToolList from './ToolList.astro';
import Footer from './Footer.astro';
import CopyWithLinks from './CopyWithLinks.astro';
import HoverPreview from './HoverPreview.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<main class="container stack">
    <section class="intro">
      <h1>{t(lang, 'home.title')}</h1>
      <p><CopyWithLinks lang={lang} text={t(lang, 'home.intro')} /></p>
      <p><CopyWithLinks lang={lang} text={t(lang, 'home.previously')} /></p>
      <p><CopyWithLinks lang={lang} text={t(lang, 'home.outside')} /></p>
    </section>

    <WorkList lang={lang} />
    <ToolList lang={lang} />
    <Footer lang={lang} />
    <HoverPreview lang={lang} />
  </main>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    /* 48px between sections: clearly separate, still one page */
    gap: 48px;
    /* Generous top space so the intro reads as the start of the page */
    padding-top: 160px;
    padding-bottom: 80px;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  h1 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-lg);
    line-height: 1.4;
    font-weight: 600;
  }
  p {
    margin: 0;
    color: var(--color-text-body);
  }
  @media (max-width: 520px) {
    .stack {
      gap: 32px;
      padding-top: 96px;
      padding-bottom: 48px;
    }
  }
</style>
