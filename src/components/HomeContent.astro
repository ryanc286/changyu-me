---
/* Homepage content (no page shell). Used by Home and as the backdrop behind case studies. */
import WorkList from './WorkList.astro';
import ToolList from './ToolList.astro';
import Footer from './Footer.astro';
import CopyWithLinks from './CopyWithLinks.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<main class="container stack">
    <section class="intro">
      <h1>{t(lang, 'home.title')}</h1>
      <p><CopyWithLinks lang={lang} text={t(lang, 'home.intro')} /></p>
      <p><CopyWithLinks lang={lang} text={t(lang, 'home.previously')} /></p>
      <p><CopyWithLinks lang={lang} text={t(lang, 'home.outside')} /></p>
    </section>

    <WorkList lang={lang} />
    <ToolList lang={lang} />
    <Footer lang={lang} />
  </main>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  h1 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-lg);
    line-height: 1.4;
    font-weight: 600;
  }
  p {
    margin: 0;
    color: var(--color-text-body);
  }
  /* Desktop: left-aligned, starting exactly where a case study card's edge sits
     (40px). Hover the strip beside an open case and the first letters peek out. */
  @media (min-width: 768px) {
    .stack {
      margin-left: 0;
      padding-left: 40px;
      max-width: calc(var(--width-content) + 40px + var(--gutter));
    }
  }
  @media (max-width: 520px) {
    .stack {
      gap: var(--space-5);
      padding-top: var(--space-6);
      padding-bottom: var(--space-6);
    }
  }
</style>
