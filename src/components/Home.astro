---
/* Homepage content for both languages. Pages in src/pages pick the language. */
import Base from '../layouts/Base.astro';
import WorkList from './WorkList.astro';
import ToolList from './ToolList.astro';
import Footer from './Footer.astro';
import OrgLink from './OrgLink.astro';
import { t, type Lang } from '../i18n/ui';
import { aapd } from '../data/companies';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// {AAPD} in the copy marks where the AAPD link with its hover card goes
const [outsideBefore, outsideAfter = ''] = t(lang, 'home.outside').split('{AAPD}');

---

<Base lang={lang} alternates={{ en: '/', 'zh-tw': '/zh-tw' }}>
  <main class="container stack">
    <section class="intro">
      <h1>{t(lang, 'home.title')}</h1>
      <p>{t(lang, 'home.intro')}</p>
      <p>
        {outsideBefore}
        <OrgLink {...aapd} description={t(lang, 'org.aapd')} />
        {outsideAfter}
      </p>
    </section>

    <WorkList lang={lang} />
    <ToolList lang={lang} />
    <Footer lang={lang} />
  </main>
</Base>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  h1 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-lg);
    line-height: 1.4;
    font-weight: 600;
  }
  p {
    margin: 0;
    color: var(--color-text-body);
  }
  @media (max-width: 520px) {
    .stack {
      gap: var(--space-5);
      padding-top: var(--space-6);
      padding-bottom: var(--space-6);
    }
  }
</style>
