---
/* Homepage content for both languages. Pages in src/pages pick the language. */
import Base from '../layouts/Base.astro';
import WorkList from './WorkList.astro';
import ToolList from './ToolList.astro';
import Footer from './Footer.astro';
import OrgLink from './OrgLink.astro';
import { t, type Lang } from '../i18n/ui';
import { aapd } from '../data/companies';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

---

<Base lang={lang} alternates={{ en: '/', 'zh-tw': '/zh-tw' }}>
  <main class="container stack">
    {
      lang === 'zh-tw' ? (
        <section class="intro">
          <h1>嗨，我是 Yu，一位把複雜變清楚的產品設計師。</h1>
          <p>
            我習慣先問清楚問題，而不是用猜的。我把複雜的規則整理成簡單的流程，也會盡早做出原型，讓團隊更快做決定。
          </p>
          <p>
            工作之外，我在{' '}
            <OrgLink {...aapd} description={t(lang, 'org.aapd')} />{' '}
            擔任設計導師，也用程式和 AI 做一些小工具。
          </p>
        </section>
      ) : (
        <section class="intro">
          <h1>Hi, I'm Yu, a designer who makes complex things clear.</h1>
          <p>
            I start with clear questions, not guesses. I turn messy rules into simple flows, and I
            build prototypes early so teams can decide fast.
          </p>
          <p>
            Outside work, I mentor designers at{' '}
            <OrgLink {...aapd} description={t(lang, 'org.aapd')} /> and build small tools with code
            and AI.
          </p>
        </section>
      )
    }

    <WorkList lang={lang} />
    <ToolList lang={lang} />
    <Footer lang={lang} />
  </main>
</Base>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  h1 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-lg);
    line-height: 1.4;
    font-weight: 600;
  }
  p {
    margin: 0;
    color: var(--color-text-body);
  }
  @media (max-width: 520px) {
    .stack {
      gap: var(--space-5);
      padding-top: var(--space-6);
      padding-bottom: var(--space-6);
    }
  }
</style>
