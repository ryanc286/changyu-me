---
/* Homepage content for both languages. Pages in src/pages pick the language. */
import Base from '../layouts/Base.astro';
import WorkList from './WorkList.astro';
import ToolList from './ToolList.astro';
import Footer from './Footer.astro';
import OrgLink from './OrgLink.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const org = {
  paypay: { name: 'PayPay', href: 'https://paypay.ne.jp/', logo: 'paypay', logoWidth: 120, logoHeight: 30 },
  carousell: { name: 'Carousell', href: 'https://carousell.com/', logo: 'carousell', logoWidth: 405, logoHeight: 80 },
  aapd: { name: 'AAPD', href: 'https://aapd.com.tw/', logo: 'aapd', logoWidth: 161, logoHeight: 31, logoDisplayHeight: 15 },
};
---

<Base lang={lang} alternates={{ en: '/', 'zh-tw': '/zh-tw' }}>
  <main class="container stack">
    {
      lang === 'zh-tw' ? (
        <section class="intro">
          <h1>嗨，我是 Yu，一位把複雜變清楚的產品設計師。</h1>
          <p>
            我在意系統思考、問對問題，也擅長把棘手的問題變成值得信任的產品。在{' '}
            <span class="nobr"><OrgLink {...org.paypay} description={t(lang, 'org.paypay')} />，</span>我讓超過 6,500 萬位使用者付款和管理金錢都很簡單，即使背後的規則一點也不簡單。
          </p>
          <p>
            在這之前，我在{' '}
            <OrgLink {...org.carousell} description={t(lang, 'org.carousell')} />{' '}
            負責成長與互動相關的設計，橫跨台灣和新加坡市場，重新設計了註冊流程和通知中心。
          </p>
          <p>
            工作之外，我在{' '}
            <OrgLink {...org.aapd} description={t(lang, 'org.aapd')} />{' '}
            擔任設計導師，也用程式和 AI 做一些小工具。
          </p>
        </section>
      ) : (
        <section class="intro">
          <h1>Hi, I'm Yu, a designer who makes complex things clear.</h1>
          <p>
            I care about systems thinking, asking the right questions, and turning messy problems into
            products people trust. At{' '}
            <OrgLink {...org.paypay} description={t(lang, 'org.paypay')} />, I make paying and managing
            money simple for 65M+ users, even when the rules behind it are not.
          </p>
          <p>
            Previously, I worked on growth and engagement at{' '}
            <OrgLink {...org.carousell} description={t(lang, 'org.carousell')} /> across Taiwan and
            Singapore, where I rebuilt sign-up and the notification center.
          </p>
          <p>
            Outside work, I mentor designers at{' '}
            <OrgLink {...org.aapd} description={t(lang, 'org.aapd')} /> and build small tools with code
            and AI.
          </p>
        </section>
      )
    }

    <WorkList lang={lang} />
    <ToolList lang={lang} />
    <Footer lang={lang} />
  </main>
</Base>

<style>
  .stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-7);
    padding-bottom: var(--space-7);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  h1 {
    margin: 0 0 var(--space-1);
    font-size: var(--text-lg);
    line-height: 1.4;
    font-weight: 600;
  }
  p {
    margin: 0;
    color: var(--color-text-body);
  }
  /* Keeps Chinese punctuation on the same line as the link before it */
  .nobr {
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .stack {
      gap: var(--space-5);
      padding-top: var(--space-6);
      padding-bottom: var(--space-6);
    }
  }
</style>
