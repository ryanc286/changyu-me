---
/* Homepage for both languages. Pages in src/pages pick the language. */
import Base from '../layouts/Base.astro';
import HomeContent from './HomeContent.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<Base lang={lang} page={lang === 'en' ? 'home' : 'home-' + lang} alternates={{ en: '/', 'zh-tw': '/zh-tw' }}>
  <HomeContent lang={lang} />
  {
    lang === 'en' && (
      <script is:inline>
        /* Case studies show this page behind them at the same scroll position.
           Remember where we are, and come back to it after closing a case. */
        (() => {
          const save = () => {
            try { sessionStorage.setItem('homeScroll', String(Math.round(scrollY))); } catch {}
          };
          addEventListener('scroll', save, { passive: true });
          addEventListener('pagehide', save);
          try {
            const ref = document.referrer ? new URL(document.referrer) : null;
            const nav = performance.getEntriesByType('navigation')[0];
            const fromCase = ref && ref.origin === location.origin && window.__isCasePath?.(ref.pathname);
            if (fromCase && nav?.type === 'navigate') {
              scrollTo(0, Number(sessionStorage.getItem('homeScroll')) || 0);
            }
          } catch {}
        })();
      </script>
    )
  }
</Base>
