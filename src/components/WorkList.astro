---
import { getCollection } from 'astro:content';
import OrgLink from './OrgLink.astro';
import { companies } from '../data/companies';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === 'zh-tw';
const items = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const orgKey = { PayPay: 'org.paypay', Carousell: 'org.carousell' } as const;
const groups = [...companies]
  .sort((a, b) => a.order - b.order)
  .map((c) => ({ company: c, cases: items.filter((i) => i.data.company === c.name) }))
  .filter((g) => g.cases.length > 0);
---

<section aria-labelledby="work-title">
  <h2 id="work-title" class="section-title">{t(lang, 'section.work')}</h2>

  <div class="groups">
    {
      groups.map(({ company, cases }) => (
        <article class="group" aria-label={company.name}>
          <h3 class="company-name">
            <OrgLink
              name={company.name}
              href={company.href}
              logo={company.logo}
              logoWidth={company.logoWidth}
              logoHeight={company.logoHeight}
              logoDisplayHeight={company.logoDisplayHeight}
              description={t(lang, orgKey[company.name as keyof typeof orgKey])}
            />
          </h3>
          <p class="company-summary">{company.summary[lang]}</p>
          <ul class="list" data-hover-list>
            {cases.map(({ id, data }) => (
              <li>
                <a href={`/${id}`} class="row" data-cover={data.cover} data-title={data.title}>
                  <span class="main">
                    <span class="title">{data.title}</span>
                    <span class="meta">
                      {(zh && data.zh?.summary) || data.summary}
                      {data.result && <> · {(zh && data.zh?.result) || data.result}</>}
                    </span>
                  </span>
                  {data.tag && <span class="tag">{(zh && data.zh?.tag) || data.tag}</span>}
                </a>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <!-- Floating cover preview. Desktop only, follows the cursor. -->
  <div class="preview" data-preview data-cover-word={t(lang, 'preview.cover')} aria-hidden="true">
    <img data-preview-img alt="" />
    <span class="preview-fallback" data-preview-fallback></span>
  </div>
</section>

<style>
  .groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-3);
  }
  .group {
    display: flex;
    flex-direction: column;
  }
  .company-name {
    margin: 0 0 var(--space-1);
    font-size: var(--text-base);
    font-weight: 600;
  }
  .company-summary {
    margin: 0 0 var(--space-3);
    color: var(--color-text-body);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--color-line);
  }
  li {
    border-top: 1px solid var(--color-line);
  }
  /* Title and tag share the first line; the summary runs full width below */
  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: var(--space-4);
    row-gap: 2px;
    padding: 14px 12px;
    margin: 0 -12px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background-color var(--duration) var(--ease-out);
  }
  .row:hover {
    background: var(--color-surface);
  }
  .main {
    display: contents;
  }
  .title {
    grid-column: 1;
    grid-row: 1;
  }
  .tag {
    grid-column: 2;
    grid-row: 1;
  }
  .meta {
    grid-column: 1 / -1;
    grid-row: 2;
  }
  .title {
    font-weight: 500;
  }
  .row:hover .title {
    text-decoration: underline;
  }
  .meta,
  .tag {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .tag {
    white-space: nowrap;
  }

  .preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10;
    width: 280px;
    aspect-ratio: 3 / 2;
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    pointer-events: none;
    opacity: 0;
    scale: 0.96;
    transition:
      opacity var(--duration) var(--ease-out),
      scale var(--duration) var(--ease-out);
  }
  .preview.is-visible {
    opacity: 1;
    scale: 1;
  }
  .preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .preview-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .preview.no-image .preview-fallback {
    display: flex;
  }
  .preview.no-image img {
    display: none;
  }
</style>

<script>
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lists = document.querySelectorAll<HTMLElement>('[data-hover-list]');
  const preview = document.querySelector<HTMLElement>('[data-preview]');
  const img = document.querySelector<HTMLImageElement>('[data-preview-img]');
  const fallback = document.querySelector<HTMLElement>('[data-preview-fallback]');

  if (canHover && lists.length && preview && img && fallback) {
    const OFFSET_X = 24;
    const OFFSET_Y = -90;
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let frame = 0;

    const place = () => {
      // Ease toward the cursor for a soft follow. Snap if reduced motion is on.
      const k = reduceMotion ? 1 : 0.18;
      x += (targetX - x) * k;
      y += (targetY - y) * k;
      preview.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      if (Math.abs(targetX - x) > 0.5 || Math.abs(targetY - y) > 0.5) {
        frame = requestAnimationFrame(place);
      } else {
        frame = 0;
      }
    };

    const setTarget = (e: PointerEvent) => {
      const w = preview.offsetWidth;
      const fitsRight = e.clientX + OFFSET_X + w < window.innerWidth - 16;
      targetX = fitsRight ? e.clientX + OFFSET_X : e.clientX - OFFSET_X - w;
      targetY = Math.max(16, e.clientY + OFFSET_Y);
      if (!frame) frame = requestAnimationFrame(place);
    };

    document.querySelectorAll<HTMLAnchorElement>('[data-hover-list] .row').forEach((row) => {
      row.addEventListener('pointerenter', (e) => {
        const cover = row.dataset.cover;
        if (cover) {
          img.src = cover;
          preview.classList.remove('no-image');
        } else {
          fallback.textContent = `${row.dataset.title} ${preview.dataset.coverWord ?? 'cover'}`;
          preview.classList.add('no-image');
        }
        if (!preview.classList.contains('is-visible')) {
          setTarget(e);
          x = targetX;
          y = targetY;
          preview.style.transform = `translate3d(${x}px, ${y}px, 0)`;
        }
        preview.classList.add('is-visible');
      });
    });

    lists.forEach((list) => {
      list.addEventListener('pointermove', setTarget);
      list.addEventListener('pointerleave', () => preview.classList.remove('is-visible'));
    });
  }
</script>
