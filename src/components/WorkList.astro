---
import { getCollection } from 'astro:content';
import { companies } from '../data/companies';
import { t, tOpt, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const items = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const groups = [...companies]
  .sort((a, b) => a.order - b.order)
  .map((c) => ({ company: c, cases: items.filter((i) => i.data.company === c.name) }))
  .filter((g) => g.cases.length > 0);
---

<section id="work" aria-labelledby="work-title">
  <h2 id="work-title" class="section-title">{t(lang, 'section.work')}</h2>

  <div class="groups">
    {
      groups.map(({ company, cases }) => (
        <article class="group" aria-label={company.name}>
          <h3 class="company-name">{company.name}</h3>
          <p class="company-summary">{t(lang, `company.${company.key}.summary`)}</p>
          <ul class="projects">
            {cases.map(({ id, data }) => {
              const zh = lang === 'zh-tw';
              const title = t(lang, `work.${id}.title`);
              const summary = t(lang, `work.${id}.summary`);
              const result = tOpt(lang, `work.${id}.result`);
              return (
                <li>
                  <a
                    href={`/${id}`}
                    class="project"
                    data-preview-link
                    data-cover={data.cover}
                    data-title={title}
                    data-summary={summary}
                    data-result={result}>
                    {/* Screen readers and keyboard users get the description too */}
                    {title}<span class="sr-only">
                      {zh ? '：' : ': '}
                      {summary}
                      {result && (zh ? `，${result}` : `, ${result}`)}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </article>
      ))
    }
  </div>

</section>

<style>
  /* One cell per company, divided by lines like the Tools list */
  .groups {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--color-line);
  }
  .group {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0 18px;
    border-top: 1px solid var(--color-line);
  }
  .company-name {
    margin: 0 0 2px;
    font-size: var(--text-base);
    font-weight: 600;
  }
  .company-summary {
    margin: 0 0 var(--space-1);
    color: var(--color-text-body);
  }

  /* Projects sit in one row and wrap when there is no room */
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px var(--space-4);
  }
  .project {
    display: inline-block;
    padding: 4px 0;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    transition: text-decoration-color var(--duration) var(--ease-out);
  }
  .project:hover,
  .project:focus-visible {
    text-decoration-color: currentColor;
  }

</style>
