---
import { getCollection } from 'astro:content';
import OrgLink from './OrgLink.astro';
import { companies } from '../data/companies';
import { t, tOpt, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const items = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const groups = [...companies]
  .sort((a, b) => a.order - b.order)
  .map((c) => ({ company: c, cases: items.filter((i) => i.data.company === c.name) }))
  .filter((g) => g.cases.length > 0);
---

<section aria-labelledby="work-title">
  <h2 id="work-title" class="section-title">{t(lang, 'section.work')}</h2>

  <div class="groups">
    {
      groups.map(({ company, cases }) => (
        <article class="group" aria-label={company.name}>
          <h3 class="company-name">
            <OrgLink
              name={company.name}
              href={company.href}
              logo={company.logo}
              logoWidth={company.logoWidth}
              logoHeight={company.logoHeight}
              logoDisplayHeight={company.logoDisplayHeight}
              description={t(lang, `org.${company.key}`)}
            />
          </h3>
          <p class="company-summary">{t(lang, `company.${company.key}.summary`)}</p>
          <ul class="projects" data-hover-list>
            {cases.map(({ id, data }) => {
              const zh = lang === 'zh-tw';
              const title = t(lang, `work.${id}.title`);
              const summary = t(lang, `work.${id}.summary`);
              const result = tOpt(lang, `work.${id}.result`);
              return (
                <li>
                  <a
                    href={`/${id}`}
                    class="project"
                    data-cover={data.cover}
                    data-title={title}
                    data-summary={summary}
                    data-result={result}>
                    {/* Screen readers and keyboard users get the description too */}
                    {title}<span class="sr-only">
                      {zh ? '：' : ': '}
                      {summary}
                      {result && (zh ? `，${result}` : `, ${result}`)}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </article>
      ))
    }
  </div>

  <!-- Floating preview: cover + title + description. Desktop only, follows the cursor. -->
  <div class="preview" data-preview data-cover-word={t(lang, 'preview.cover')} aria-hidden="true">
    <div class="preview-media">
      <img data-preview-img alt="" />
      <span class="preview-fallback" data-preview-fallback></span>
    </div>
    <div class="preview-text">
      <span class="preview-title" data-preview-title></span>
      <span class="preview-summary" data-preview-summary></span>
      <span class="preview-result" data-preview-result></span>
    </div>
  </div>
</section>

<style>
  .groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-top: var(--space-3);
  }
  .group {
    display: flex;
    flex-direction: column;
  }
  .company-name {
    margin: 0 0 var(--space-1);
    font-size: var(--text-base);
    font-weight: 600;
  }
  .company-summary {
    margin: 0 0 var(--space-3);
    color: var(--color-text-body);
  }

  /* Projects sit in one row and wrap when there is no room */
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  .project {
    display: inline-block;
    padding: 4px 0;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    transition: text-decoration-color var(--duration) var(--ease-out);
  }
  .project:hover,
  .project:focus-visible {
    text-decoration-color: currentColor;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10;
    width: 300px;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-line-strong);
    box-shadow: var(--shadow-float);
    pointer-events: none;
    opacity: 0;
    scale: 0.96;
    transition:
      opacity var(--duration) var(--ease-out),
      scale var(--duration) var(--ease-out);
  }
  .preview.is-visible {
    opacity: 1;
    scale: 1;
  }
  .preview-media {
    position: relative;
    aspect-ratio: 3 / 2;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
  }
  .preview-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .preview-fallback {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .preview.no-image .preview-fallback {
    display: flex;
  }
  .preview.no-image img {
    display: none;
  }
  .preview-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px 14px;
    line-height: 1.45;
  }
  .preview-title {
    font-weight: 500;
  }
  .preview-summary {
    font-size: var(--text-sm);
    color: var(--color-text-body);
  }
  .preview-result {
    margin-top: 4px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
  }
  .preview-result:empty {
    display: none;
  }
</style>

<script>
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lists = document.querySelectorAll<HTMLElement>('[data-hover-list]');
  const preview = document.querySelector<HTMLElement>('[data-preview]');
  const img = document.querySelector<HTMLImageElement>('[data-preview-img]');
  const fallback = document.querySelector<HTMLElement>('[data-preview-fallback]');
  const titleEl = document.querySelector<HTMLElement>('[data-preview-title]');
  const summaryEl = document.querySelector<HTMLElement>('[data-preview-summary]');
  const resultEl = document.querySelector<HTMLElement>('[data-preview-result]');

  if (canHover && lists.length && preview && img && fallback && titleEl && summaryEl && resultEl) {
    const OFFSET = 20;
    const EDGE = 16;
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let frame = 0;

    const place = () => {
      // Ease toward the target for a soft follow. Snap if reduced motion is on.
      const k = reduceMotion ? 1 : 0.18;
      x += (targetX - x) * k;
      y += (targetY - y) * k;
      preview.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      if (Math.abs(targetX - x) > 0.5 || Math.abs(targetY - y) > 0.5) {
        frame = requestAnimationFrame(place);
      } else {
        frame = 0;
      }
    };

    // Below-right of the point by default; flips left/up when it would leave the window
    const aim = (px: number, py: number) => {
      const w = preview.offsetWidth;
      const h = preview.offsetHeight;
      targetX = px + OFFSET + w < innerWidth - EDGE ? px + OFFSET : px - OFFSET - w;
      targetY = py + OFFSET + h < innerHeight - EDGE ? py + OFFSET : py - OFFSET - h;
      targetX = Math.max(EDGE, targetX);
      targetY = Math.max(EDGE, targetY);
      if (!frame) frame = requestAnimationFrame(place);
    };

    const fill = (link: HTMLAnchorElement) => {
      const { cover, title = '', summary = '', result = '' } = link.dataset;
      titleEl.textContent = title;
      summaryEl.textContent = summary;
      resultEl.textContent = result;
      if (cover) {
        img.src = cover;
        preview.classList.remove('no-image');
      } else {
        fallback.textContent = `${title} ${preview.dataset.coverWord ?? 'cover'}`;
        preview.classList.add('no-image');
      }
    };

    const show = (link: HTMLAnchorElement, px: number, py: number) => {
      const wasHidden = !preview.classList.contains('is-visible');
      fill(link);
      aim(px, py);
      if (wasHidden) {
        x = targetX;
        y = targetY;
        preview.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      }
      preview.classList.add('is-visible');
    };
    const hide = () => preview.classList.remove('is-visible');

    document.querySelectorAll<HTMLAnchorElement>('[data-hover-list] .project').forEach((link) => {
      link.addEventListener('pointerenter', (e) => show(link, e.clientX, e.clientY));
      link.addEventListener('pointermove', (e) => aim(e.clientX, e.clientY));
      link.addEventListener('pointerleave', hide);
      // Keyboard: show the preview under the focused link
      link.addEventListener('focus', () => {
        if (!link.matches(':focus-visible')) return;
        const r = link.getBoundingClientRect();
        show(link, r.left, r.bottom);
      });
      link.addEventListener('blur', hide);
    });
    window.addEventListener('scroll', hide, { passive: true });
  }
</script>
