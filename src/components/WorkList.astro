---
import { getCollection } from 'astro:content';
import { companies } from '../data/companies';
import Burst from './Burst.astro';
import { t, tOpt, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const items = (await getCollection('work', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
// Chinese homepage links to the Chinese case when there is one
const zhIds = new Set(lang === 'zh-tw' ? (await getCollection('workZh')).map((e) => e.id) : []);
const href = (id: string) => (zhIds.has(id) ? `/zh-tw/${id}` : `/${id}`);
const groups = [...companies]
  .sort((a, b) => a.order - b.order)
  .map((c) => ({ company: c, cases: items.filter((i) => i.data.company === c.name) }))
  .filter((g) => g.cases.length > 0);
// Hand-drawn arrows: a slightly wavy shaft and a head, three variations
const ARROWS: [string, string][] = [
  ['M1 8 C 7 6.5, 13 7.5, 20 6.5', 'M14.5 2 L 20.5 6.6 L 14 11.5'],
  ['M1 7.5 C 7 7, 13 6.5, 20 7', 'M15 2.5 L 20.5 7 L 14.5 11'],
  ['M1 6.8 C 7 7.8, 13 6.2, 20 7', 'M14.6 2.2 L 20.4 7 L 15 11.6'],
];
---

<section id="work" aria-labelledby="work-title">
  <h2 id="work-title" class="section-title"><Burst />{t(lang, 'section.work')}</h2>

  <div class="groups">
    {
      groups.map(({ company, cases }) => (
        <article class="group" aria-label={company.name}>
          <h3 class="company-name">{company.name}</h3>
          <p class="company-summary">{t(lang, `company.${company.key}.summary`)}</p>
          <ul class="projects">
            {cases.map(({ id, data }, i) => {
              const zh = lang === 'zh-tw';
              const title = t(lang, `work.${id}.title`);
              const summary = t(lang, `work.${id}.summary`);
              // A result still waiting for its number ("[X]%") stays hidden until it's filled in
              const raw = tOpt(lang, `work.${id}.result`);
              const result = /\[x\]/i.test(raw) ? '' : raw;
              return (
                <li>
                  <a
                    href={href(id)}
                    class="project"
                    data-preview-link
                    data-cover={data.cover}
                    data-title={title}
                    data-summary={summary}
                    data-result={result}>
                    {/* Screen readers and keyboard users get the description too */}
                    {title}
                    {/* A hand-drawn arrow, same pen as the headline; each one a little different */}
                    <svg class="arrow" viewBox="0 0 22 14" aria-hidden="true">
                      <path d={ARROWS[i % ARROWS.length][0]} />
                      <path d={ARROWS[i % ARROWS.length][1]} />
                    </svg>
                    <span class="sr-only">
                      {zh ? '：' : ': '}
                      {summary}
                      {result && (zh ? `，${result}` : `, ${result}`)}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </article>
      ))
    }
  </div>

</section>

<style>
  /* One cell per company, divided by lines like the Tools list */
  .groups {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--color-line);
  }
  .group {
    display: flex;
    flex-direction: column;
    padding: var(--space-3) 0 18px;
    border-top: 1px solid var(--color-line);
  }
  .company-name {
    margin: 0 0 2px;
    font-size: var(--text-base);
    font-weight: 600;
  }
  .company-summary {
    margin: 0 0 var(--space-1);
    color: var(--color-text-body);
  }

  /* One project per line, each with a hand-drawn arrow after it */
  .projects {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }
  .project {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    font-weight: 500;
    text-decoration: none;
  }
  .arrow {
    flex: none;
    width: 1.2em;
    height: 0.8em;
    overflow: visible;
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition:
      translate var(--duration) var(--ease-out),
      stroke var(--duration) var(--ease-out);
  }
  .project:hover .arrow,
  .project:focus-visible .arrow {
    translate: 4px 0;
    stroke: currentColor;
  }

</style>
