---
/* Shown for any address that doesn't exist (Vercel serves this automatically) */
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Chang Yu" description="This page doesn't exist.">
  <main>
    <h1>This page doesn't exist.</h1>
    <p lang="zh-Hant-TW">找不到這個頁面。</p>
    <p><a href="/">Back to home</a> <span aria-hidden="true">/</span> <a href="/zh-tw" lang="zh-Hant-TW">回到首頁</a></p>
  </main>
</Base>

<style>
  main {
    max-width: 600px;
    margin: 0 auto;
    padding: 160px var(--gutter, 24px) 96px;
  }
  h1 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
    font-weight: 600;
  }
  p {
    margin: 0 0 var(--space-3);
    color: var(--color-text-body);
  }
  span {
    color: var(--color-text-muted);
  }
</style>
