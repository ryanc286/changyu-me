---
import { getCollection, render } from 'astro:content';
import CaseStudy from '../layouts/CaseStudy.astro';
import Media from '../components/case/Media.astro';
import Stats from '../components/case/Stats.astro';
import Hypothesis from '../components/case/Hypothesis.astro';
import MediaRow from '../components/case/MediaRow.astro';
import Annotated from '../components/case/Annotated.astro';
import VideoRow from '../components/case/VideoRow.astro';
import StepCompare from '../components/case/StepCompare.astro';
import FlowSwap from '../components/case/FlowSwap.astro';
import { t } from '../i18n/ui';

export async function getStaticPaths() {
  const work = (await getCollection('work', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const title = t('en', `work.${entry.id}.title`);
const summary = t('en', `work.${entry.id}.summary`);
---

<CaseStudy
  title={title}
  subtitle={d.subtitle ?? summary}
  description={summary}
  headings={headings.filter((h) => h.depth === 2)}
  meta={[
    { label: 'Role', value: d.role },
    { label: 'Company', value: d.company },
    { label: 'Timeline', value: d.timeline },
    { label: 'Type', value: d.type },
  ]}
>
  <Content components={{ Media, MediaRow, Annotated, VideoRow, StepCompare, FlowSwap, Stats, Hypothesis }} />
</CaseStudy>
