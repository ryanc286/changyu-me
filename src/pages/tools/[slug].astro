---
/* Tool pages use the same card-over-homepage layout as case studies. */
import { getCollection, render } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';
import Media from '../../components/case/Media.astro';
import Stats from '../../components/case/Stats.astro';
import Hypothesis from '../../components/case/Hypothesis.astro';
import MediaRow from '../../components/case/MediaRow.astro';
import Annotated from '../../components/case/Annotated.astro';
import VideoRow from '../../components/case/VideoRow.astro';
import StepCompare from '../../components/case/StepCompare.astro';
import FlowSwap from '../../components/case/FlowSwap.astro';
import CompareSlider from '../../components/case/CompareSlider.astro';
import ClickMap from '../../components/case/ClickMap.astro';
import DetailList from '../../components/case/DetailList.astro';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  const tools = (await getCollection('tools', ({ data }) => !data.link)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return tools.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const summary = t('en', `tools.${entry.id}.summary`);
---

<CaseStudy
  title={t('en', `tools.${entry.id}.title`)}
  subtitle={d.subtitle ?? summary}
  description={summary}
  headings={headings.filter((h) => h.depth === 2)}
  meta={[
    { label: 'Role', value: d.role },
    { label: 'Company', value: d.company },
    { label: 'Timeline', value: d.timeline },
    { label: 'Type', value: d.type ?? t('en', `tools.${entry.id}.type`) },
  ]}
>
  <Content components={{ Media, MediaRow, Annotated, VideoRow, StepCompare, FlowSwap, CompareSlider, ClickMap, DetailList, Stats, Hypothesis }} />
</CaseStudy>
