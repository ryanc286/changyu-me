---
import { getCollection, render } from 'astro:content';
import Case from '../../layouts/Case.astro';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  const tools = await getCollection('tools', ({ data }) => !data.link);
  return tools.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Case
  title={t('en', `tools.${entry.id}.title`)}
  eyebrow={t('en', `tools.${entry.id}.type`)}
  summary={t('en', `tools.${entry.id}.summary`)}>
  <Content />
</Case>
