---
/* Tool pages use the same card-over-homepage layout as case studies. */
import { getCollection, render } from 'astro:content';
import CaseStudy from '../../layouts/CaseStudy.astro';
import Media from '../../components/case/Media.astro';
import Stats from '../../components/case/Stats.astro';
import Hypothesis from '../../components/case/Hypothesis.astro';
import { t } from '../../i18n/ui';

export async function getStaticPaths() {
  const tools = (await getCollection('tools', ({ data }) => !data.link)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  // Next tool follows the homepage order and wraps around to the first
  return tools.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: tools[(i + 1) % tools.length] },
  }));
}

const { entry, next } = Astro.props;
const { Content, headings } = await render(entry);
const summary = t('en', `tools.${entry.id}.summary`);
---

<CaseStudy
  title={t('en', `tools.${entry.id}.title`)}
  subtitle={summary}
  description={summary}
  headings={headings.filter((h) => h.depth === 2)}
  meta={[{ label: 'Type', value: t('en', `tools.${entry.id}.type`) }]}
  next={next.id !== entry.id
    ? { href: `/tools/${next.id}`, title: t('en', `tools.${next.id}.title`) }
    : undefined}
>
  <Content components={{ Media, Stats, Hypothesis }} />
</CaseStudy>
